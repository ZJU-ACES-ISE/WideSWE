+@pytest.mark.django_db
+def test_dispatcher_startup_uses_in_memory_log_level(settings):
+    original_logging_settings = copy.deepcopy(settings.LOGGING)
+    dispatcherd_logger = logging.getLogger('dispatcherd')
+    original_handlers = dispatcherd_logger.handlers[:]
+    original_level = dispatcherd_logger.level
+    original_propagate = dispatcherd_logger.propagate
+    settings.LOGGING = {
+        'version': 1,
+        'disable_existing_loggers': False,
+        'filters': {
+            'dynamic_level_filter': {
+                '()': 'awx.main.utils.filters.DynamicLevelFilter',
+            }
+        },
+        'handlers': {
+            'console': {
+                'class': 'logging.StreamHandler',
+                'filters': ['dynamic_level_filter'],
+                'stream': 'ext://sys.stdout',
+            }
+        },
+        'loggers': {
+            'dispatcherd': {
+                'handlers': ['console'],
+                'level': 'INFO',
+                'propagate': False,
+            }
+        },
+    }
+    settings.LOG_AGGREGATOR_LEVEL = 'WARNING'
+    logging.config.dictConfig(settings.LOGGING)
+    prior_dispatcher_settings = dispatcher_settings._wrapped
+
+    def start_dispatcherd():
+        dispatcher_factories.from_settings()
+
+    try:
+        with (
+            mock.patch('awx.main.management.commands.run_dispatcher.flag_enabled', return_value=True),
+            mock.patch('awx.main.management.commands.run_dispatcher.run_service', side_effect=start_dispatcherd),
+            mock.patch.object(dispatcher_factories, 'producers_from_settings', return_value=[]),
+            mock.patch.object(dispatcher_factories, 'pool_from_settings', return_value=mock.Mock()),
+            mock.patch.object(dispatcher_factories, 'DispatcherMain', return_value=mock.Mock()),
+        ):
+            Command().handle()
+
+        assert dispatcherd_logger.level == logging.WARNING
+        assert all(not isinstance(log_filter, DynamicLevelFilter) for handler in dispatcherd_logger.handlers for log_filter in handler.filters)
+    finally:
+        settings.LOGGING = original_logging_settings
+        dispatcherd_logger.handlers = original_handlers
+        dispatcherd_logger.setLevel(original_level)
+        dispatcherd_logger.propagate = original_propagate
+        dispatcher_settings._wrapped = prior_dispatcher_settings
