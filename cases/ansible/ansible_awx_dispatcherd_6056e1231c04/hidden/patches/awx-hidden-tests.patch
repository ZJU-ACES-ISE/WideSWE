+@pytest.mark.django_db
+def test_log_level_setting_change_reaches_dispatcherd(settings):
+    settings.LOG_AGGREGATOR_LEVEL = 'DEBUG'
+    settings.CLUSTER_HOST_ID = 'control-node'
+    published_messages = []
+
+    class DummyBroker:
+        def publish_message(self, channel, message):
+            published_messages.append((channel, message))
+
+        def close(self):
+            pass
+
+    dummy_broker = DummyBroker()
+    view = SettingSingletonDetail()
+    view.category_slug = 'logging'
+    view.request = mock.Mock(user=None)
+    settings_qs = mock.Mock()
+    settings_qs.filter.return_value.order_by.return_value.first.return_value = None
+    view.get_queryset = mock.Mock(return_value=settings_qs)
+    serializer = mock.Mock(validated_data={'LOG_AGGREGATOR_LEVEL': 'DEBUG'}, instance=SimpleNamespace())
+
+    def run_cache_invalidation(setting_keys):
+        clear_setting_cache(setting_keys)
+
+    with (
+        mock.patch('awx.conf.views.connection.on_commit', side_effect=lambda callback: callback()),
+        mock.patch('awx.conf.views.clear_setting_cache.delay', side_effect=run_cache_invalidation),
+        mock.patch('awx.conf.views.Setting.objects.create'),
+        mock.patch('awx.conf.views.settings_registry.is_setting_read_only', return_value=False),
+        mock.patch('awx.conf.views.settings_registry.is_setting_encrypted', return_value=False),
+        mock.patch('awx.conf.views.reconfigure_rsyslog.delay'),
+        mock.patch('awx.conf.views.flag_enabled', create=True, return_value=True),
+        mock.patch('dispatcherd.control.get_broker', return_value=dummy_broker),
+    ):
+        view.perform_update(serializer)
+
+    assert published_messages, 'control command was not sent through the broker'
+    payloads = [json.loads(payload) for _queue, payload in published_messages]
+    assert any(body.get('control') == 'set_log_level' and body.get('control_data') == {'level': 'DEBUG'} for body in payloads)
+
