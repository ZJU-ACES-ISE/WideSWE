diff --git a/metrics_utility/test/test_anonymized_rollups/test_task_executions_anonymized_rollup.py b/metrics_utility/test/test_anonymized_rollups/test_task_executions_anonymized_rollup.py
new file mode 100644
index 0000000..1e24e3e
--- /dev/null
+++ b/metrics_utility/test/test_anonymized_rollups/test_task_executions_anonymized_rollup.py
@@ -0,0 +1,220 @@
+import pandas as pd
+import pytest
+
+from metrics_utility.anonymized_rollups.task_executions_anonymized_rollup import TaskExecutionsAnonymizedRollup
+
+
+IDENTITY_KEYS = ('collector_type', 'task_name', 'function_name', 'name')
+TOTAL_KEYS = ('executions_total', 'execution_count', 'count', 'total')
+DURATION_KEYS = (
+    'execution_duration_total_seconds',
+    'execution_time_seconds',
+    'total_duration_seconds',
+    'duration_seconds',
+)
+
+
+def _candidate_frames(groups):
+    """Build equivalent raw-event and pre-aggregated task statistics."""
+    raw_rows = []
+    aggregate_rows = []
+    start = pd.Timestamp('2025-06-13T00:00:00Z')
+
+    for task_name, durations in groups:
+        for offset, duration in enumerate(durations):
+            started_at = start + pd.Timedelta(hours=offset)
+            completed_at = None if duration is None else started_at + pd.Timedelta(seconds=duration)
+            raw_rows.append(
+                {
+                    'collector_type': task_name,
+                    'started_at': None if duration is None else started_at.isoformat(),
+                    'completed_at': None if completed_at is None else completed_at.isoformat(),
+                }
+            )
+
+        aggregate_rows.append(
+            {
+                'task_name': task_name,
+                'executions_total': len(durations),
+                'executions_successful': sum(duration is not None for duration in durations),
+                'executions_failed': sum(duration is None for duration in durations),
+                'execution_time_seconds': sum(duration or 0 for duration in durations),
+            }
+        )
+
+    return [pd.DataFrame(raw_rows), pd.DataFrame(aggregate_rows)]
+
+
+def _identity(item):
+    for key in IDENTITY_KEYS:
+        if key in item:
+            return str(item[key]).strip('"')
+    return None
+
+
+def _metric(item, keys):
+    for key in keys:
+        if key in item and isinstance(item[key], (int, float)) and not isinstance(item[key], bool):
+            return item[key]
+    return None
+
+
+def _summary_item(result, task_name):
+    for item in result:
+        if isinstance(item, dict) and _identity(item) == task_name.strip('"'):
+            return item
+    raise AssertionError(f'No observability entry found for {task_name!r}: {result!r}')
+
+
+def _assert_summary(result, task_name, total, duration=None):
+    item = _summary_item(result, task_name)
+    assert _metric(item, TOTAL_KEYS) == total
+    if duration is not None:
+        assert _metric(item, DURATION_KEYS) == pytest.approx(duration)
+    return item
+
+
+def _prepare_observability(rollup, groups):
+    errors = []
+    for dataframe in _candidate_frames(groups):
+        try:
+            result = rollup.prepare(dataframe)
+        except Exception as exc:
+            errors.append(repr(exc))
+            continue
+        if isinstance(result, list) and result:
+            return result
+    raise AssertionError(f'No supported task-observability input produced data: {errors!r}')
+
+
+def _base_observability(rollup, groups):
+    for dataframe in _candidate_frames(groups):
+        try:
+            result = rollup.base(dataframe)
+        except Exception:
+            continue
+        if isinstance(result, dict) and isinstance(result.get('json'), list) and result['json']:
+            return result
+    raise AssertionError('base() did not expose task observability as a non-empty json list')
+
+
+# ---------------------------------------------------------------------------
+# prepare()
+# ---------------------------------------------------------------------------
+
+
+def test_prepare_none_returns_empty_list():
+    rollup = TaskExecutionsAnonymizedRollup()
+    assert rollup.prepare(None) == []
+
+
+def test_prepare_empty_dataframe_returns_empty_list():
+    rollup = TaskExecutionsAnonymizedRollup()
+    assert rollup.prepare(pd.DataFrame()) == []
+
+
+def test_prepare_hourly_collector_counts_and_durations():
+    rollup = TaskExecutionsAnonymizedRollup()
+    result = _prepare_observability(rollup, [('unified_jobs', [60, 120])])
+    _assert_summary(result, 'unified_jobs', total=2, duration=180)
+
+
+def test_prepare_snapshot_collector_expected_1():
+    rollup = TaskExecutionsAnonymizedRollup()
+    result = _prepare_observability(rollup, [('feature_flags_service', [5])])
+    _assert_summary(result, 'feature_flags_service', total=1, duration=5)
+
+
+def test_prepare_executions_exceeding_expected_give_zero_missing():
+    rollup = TaskExecutionsAnonymizedRollup()
+    result = _prepare_observability(rollup, [('unified_jobs', [60] * 25)])
+    _assert_summary(result, 'unified_jobs', total=25, duration=1500)
+
+
+def test_prepare_unknown_collector_defaults_to_24_expected():
+    rollup = TaskExecutionsAnonymizedRollup()
+    result = _prepare_observability(rollup, [('some_new_collector', [60])])
+    _assert_summary(result, 'some_new_collector', total=1, duration=60)
+
+
+def test_prepare_missing_timestamps_gives_none_durations():
+    rollup = TaskExecutionsAnonymizedRollup()
+    result = _prepare_observability(rollup, [('unified_jobs', [None])])
+    _assert_summary(result, 'unified_jobs', total=1)
+
+
+def test_prepare_strips_surrounding_quotes_from_collector_type():
+    """Quoted task identifiers remain recognizable in the observability output."""
+    rollup = TaskExecutionsAnonymizedRollup()
+    result = _prepare_observability(rollup, [('"unified_jobs"', [60])])
+    _assert_summary(result, 'unified_jobs', total=1, duration=60)
+
+
+def test_prepare_multiple_collector_types_produces_one_row_each():
+    rollup = TaskExecutionsAnonymizedRollup()
+    result = _prepare_observability(
+        rollup,
+        [('unified_jobs', [60]), ('feature_flags_service', [10])],
+    )
+    _assert_summary(result, 'unified_jobs', total=1, duration=60)
+    _assert_summary(result, 'feature_flags_service', total=1, duration=10)
+
+
+def test_prepare_all_snapshot_collectors_expect_1():
+    rollup = TaskExecutionsAnonymizedRollup()
+    for collector_type in ('execution_environments', 'table_metadata', 'controller_version_service', 'feature_flags_service'):
+        result = _prepare_observability(rollup, [(collector_type, [1])])
+        _assert_summary(result, collector_type, total=1, duration=1)
+
+
+def test_prepare_all_hourly_collectors_expect_24():
+    rollup = TaskExecutionsAnonymizedRollup()
+    for collector_type in ('unified_jobs', 'job_host_summary_service', 'credentials_service', 'main_jobevent_service'):
+        result = _prepare_observability(rollup, [(collector_type, [60])])
+        _assert_summary(result, collector_type, total=1, duration=60)
+
+
+# ---------------------------------------------------------------------------
+# merge()
+# ---------------------------------------------------------------------------
+
+
+def test_merge_always_returns_new_data():
+    rollup = TaskExecutionsAnonymizedRollup()
+    old = _prepare_observability(rollup, [('unified_jobs', [1] * 5)])
+    new = _prepare_observability(rollup, [('unified_jobs', [1] * 10)])
+    result = rollup.merge(old, new)
+    item = _summary_item(result, 'unified_jobs')
+    assert _metric(item, TOTAL_KEYS) >= 10
+
+
+def test_merge_with_none_old_returns_new():
+    rollup = TaskExecutionsAnonymizedRollup()
+    new = _prepare_observability(rollup, [('unified_jobs', [1] * 3)])
+    result = rollup.merge(None, new)
+    _assert_summary(result, 'unified_jobs', total=3)
+
+
+# ---------------------------------------------------------------------------
+# base()
+# ---------------------------------------------------------------------------
+
+
+def test_base_none_returns_empty_json():
+    rollup = TaskExecutionsAnonymizedRollup()
+    result = rollup.base(None)
+    assert result == {'json': []}
+
+
+def test_base_with_prepared_list():
+    rollup = TaskExecutionsAnonymizedRollup()
+    data = _prepare_observability(rollup, [('unified_jobs', [1] * 5)])
+    result = rollup.base(data)
+    assert isinstance(result, dict)
+    _assert_summary(result['json'], 'unified_jobs', total=5)
+
+
+def test_base_with_dataframe_calls_prepare():
+    rollup = TaskExecutionsAnonymizedRollup()
+    result = _base_observability(rollup, [('unified_jobs', [60])])
+    _assert_summary(result['json'], 'unified_jobs', total=1, duration=60)
