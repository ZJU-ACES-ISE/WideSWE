+describe('getInputs', () => {
+  const originalEnv = process.env;
+
+  beforeEach(() => {
+    process.env = Object.keys(process.env).reduce((object, key) => {
+      if (!key.startsWith('INPUT_')) {
+        object[key] = process.env[key];
+      }
+      return object;
+    }, {});
+  });
+
+  afterEach(() => {
+    process.env = originalEnv;
+  });
+
+  function setRequiredBooleanInputs(): void {
+    setInput('load', 'false');
+    setInput('no-cache', 'false');
+    setInput('push', 'false');
+    setInput('pull', 'false');
+  }
+
+  function mockBuildGitContext(value: string): {mockRestore(): void} {
+    const instanceTarget = Build.prototype as unknown as {gitContext?: () => string | Promise<string>};
+    if (typeof instanceTarget.gitContext === 'function') {
+      return vi.spyOn(instanceTarget, 'gitContext').mockReturnValue(value);
+    }
+    const staticTarget = Build as unknown as {gitContext?: () => string | Promise<string>};
+    if (typeof staticTarget.gitContext === 'function') {
+      return vi.spyOn(staticTarget, 'gitContext').mockReturnValue(value);
+    }
+    throw new Error('Build.gitContext is not implemented');
+  }
+
+  test('uses Build git context when context input is empty', async () => {
+    const versionSpy = vi.spyOn(Buildx.prototype, 'version').mockResolvedValue('0.29.0');
+    try {
+      process.env.BUILDX_SEND_GIT_QUERY_AS_INPUT = 'true';
+      setRequiredBooleanInputs();
+      const context = await loadContextModule();
+      const inputs = await context.getInputs();
+      expect(inputs.context).toBe('https://github.com/docker/build-push-action.git?ref=refs/heads/master');
+    } finally {
+      versionSpy.mockRestore();
+    }
+  });
+
+  test('renders defaultContext templates from Build git context', async () => {
+    const gitContext = 'https://github.com/docker/build-push-action.git#refs/heads/master';
+    const gitContextSpy = mockBuildGitContext(gitContext);
+    try {
+      setRequiredBooleanInputs();
+      setInput('context', '{{defaultContext}}:subdir');
+      const context = await loadContextModule();
+      const inputs = await context.getInputs();
+      expect(inputs.context).toBe(`${gitContext}:subdir`);
+    } finally {
+      gitContextSpy.mockRestore();
+    }
+  });
+});
