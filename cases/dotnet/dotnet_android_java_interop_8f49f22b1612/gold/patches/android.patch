+	/// nested under <c>&lt;PrivateImplementationDetails&gt;</c>.
+	/// </summary>
+	public FieldDefinitionHandle GetOrAddUtf8Field (string value)
+	{
+		if (_utf8FieldCache.TryGetValue (value, out var existing)) {
+			return existing;
+		}
