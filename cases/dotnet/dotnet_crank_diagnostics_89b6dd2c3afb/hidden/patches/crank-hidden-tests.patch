+        [Fact]
+        public void NewJobUsesLegacyCompatibleCliModeDefaults()
+        {
+            var job = JObject.FromObject(new Job());
+
+            Assert.Equal("default", (string)job["DotNetTraceCollectMode"]);
+            Assert.Equal(0, (int?)job["DotNetTraceStopTimeoutSec"]);
+        }
+
+        [Fact]
+        public void CliModeConfigurationRoundTripsThroughJobJson()
+        {
+            const string json = """
+{
+  "DotNetTrace": true,
+  "DotNetTraceCollectMode": "collect-linux",
+  "DotNetTraceStopTimeoutSec": 240
+}
+""";
+
+            var job = Newtonsoft.Json.JsonConvert.DeserializeObject<Job>(json);
+            var roundTripped = JObject.FromObject(job);
+
+            Assert.Equal("collect-linux", (string)roundTripped["DotNetTraceCollectMode"]);
+            Assert.Equal(240, (int?)roundTripped["DotNetTraceStopTimeoutSec"]);
+        }
