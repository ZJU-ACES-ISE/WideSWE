+        [Fact]
+        public async Task CliModesReceiveSigIntAndKeepACompletedTrace()
+        {
+            using var run = await DotNetTraceProcessRun.StartAsync(
+                mode: "collect",
+                providers: "dotnet-common");
+
+            await run.StopAsync();
