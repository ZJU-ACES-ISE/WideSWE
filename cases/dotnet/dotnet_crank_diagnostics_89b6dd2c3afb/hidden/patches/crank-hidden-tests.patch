+    [CollectionDefinition(nameof(DotNetTraceProcessCollection), DisableParallelization = true)]
+    public sealed class DotNetTraceProcessCollection
+    {
+    }
+
+    internal sealed class DotNetTraceProcessRun : IDisposable
+    {
+        private const string ArgumentsFileName = "dotnet-trace.args";
+        private const string SignalFileName = "dotnet-trace.sigint";
+        private static readonly Type StartupType = typeof(Startup);
+        private static readonly MethodInfo StartMethod = StartupType.GetMethod(
+            "StartDotNetTrace",
+            BindingFlags.Static | BindingFlags.NonPublic);
+        private static readonly FieldInfo StopSignalField = StartupType.GetField(
+            "dotnetTraceManualReset",
+            BindingFlags.Static | BindingFlags.NonPublic);
+        private static readonly FieldInfo TraceTaskField = StartupType.GetField(
+            "dotnetTraceTask",
+            BindingFlags.Static | BindingFlags.NonPublic);
+        private static readonly FieldInfo RootTempField = StartupType.GetField(
+            "_rootTempDir",
+            BindingFlags.Static | BindingFlags.NonPublic);
+
+        private readonly string _directory;
+        private readonly string _originalPath;
+        private bool _stopped;
+
+        private DotNetTraceProcessRun(
+            string directory,
+            string originalPath,
+            IReadOnlyList<string> arguments)
+        {
+            _directory = directory;
+            _originalPath = originalPath;
+            Arguments = arguments;
+        }
+
+        public IReadOnlyList<string> Arguments { get; }
+
+        public static async Task<DotNetTraceProcessRun> StartAsync(
+            string mode,
+            string providers,
+            int bufferSizeMb = 256,
+            int stopTimeoutSec = 5,
+            bool writePartialTrace = false,
+            bool ignoreSigInt = false)
+        {
+            Assert.NotNull(StartMethod);
+            Assert.NotNull(StopSignalField);
+            Assert.NotNull(TraceTaskField);
+            Assert.NotNull(RootTempField);
+
+            var directory = Path.Combine(
+                Path.GetTempPath(),
+                "crank-dotnet-trace-hidden-" + Guid.NewGuid().ToString("N"));
+            Directory.CreateDirectory(directory);
+
+            var toolRoot = Path.Combine(directory, "agent-temp");
+            var toolDirectory = Path.Combine(toolRoot, "dotnet-trace-tools");
+            var binDirectory = Path.Combine(directory, "bin");
+            Directory.CreateDirectory(toolDirectory);
+            Directory.CreateDirectory(binDirectory);
+
+            var cachedTool = Path.Combine(toolDirectory, "dotnet-trace");
+            var pathTool = Path.Combine(binDirectory, "dotnet-trace");
+            WriteFakeDotNetTrace(cachedTool);
+            File.Copy(cachedTool, pathTool);
+
+            if (writePartialTrace)
+            {
+                File.WriteAllText(Path.Combine(directory, ".write-partial"), "");
+            }
+            if (ignoreSigInt)
+            {
+                File.WriteAllText(Path.Combine(directory, ".ignore-sigint"), "");
+            }
+
+            RootTempField.SetValue(null, toolRoot);
+            var originalPath = Environment.GetEnvironmentVariable("PATH") ?? "";
+            Environment.SetEnvironmentVariable(
+                "PATH",
+                binDirectory + Path.PathSeparator + originalPath);
+
+            var payload = JObject.FromObject(new
+            {
+                DotNetTrace = true,
+                DotNetTraceProviders = providers,
+                DotNetTraceBufferSizeMB = bufferSizeMb,
+                DotNetTraceCollectMode = mode,
+                DotNetTraceStopTimeoutSec = stopTimeoutSec,
+                BasePath = directory,
+                ProcessId = Process.GetCurrentProcess().Id,
+            });
+            var job = payload.ToObject<Job>();
+
+            StartMethod.Invoke(null, new object[] { job });
+
+            try
+            {
+                var argumentsPath = Path.Combine(directory, ArgumentsFileName);
+                await WaitForFileAsync(argumentsPath, TimeSpan.FromSeconds(3));
+                var arguments = File.ReadAllLines(argumentsPath);
+                return new DotNetTraceProcessRun(directory, originalPath, arguments);
+            }
+            catch
+            {
+                try
+                {
+                    await StopCurrentTraceAsync();
+                }
+                catch
+                {
+                }
+                Environment.SetEnvironmentVariable("PATH", originalPath);
+                throw;
+            }
+        }
+
+        public async Task StopAsync()
+        {
+            if (_stopped)
+            {
+                return;
+            }
+
+            _stopped = true;
+            try
+            {
+                await StopCurrentTraceAsync();
+            }
+            finally
+            {
+                Environment.SetEnvironmentVariable("PATH", _originalPath);
+            }
+        }
+
+        public bool ReceivedSigInt =>
+            File.Exists(Path.Combine(_directory, SignalFileName));
+
+        public string TracePath => Path.Combine(_directory, "trace.nettrace");
+
+        public void Dispose()
+        {
+            if (!_stopped)
+            {
+                StopAsync().GetAwaiter().GetResult();
+            }
+        }
+
+        private static async Task StopCurrentTraceAsync()
+        {
+            var stopSignal = StopSignalField.GetValue(null) as ManualResetEvent;
+            stopSignal?.Set();
+
+            if (TraceTaskField.GetValue(null) is Task traceTask)
+            {
+                await traceTask.WaitAsync(TimeSpan.FromSeconds(12));
+            }
+        }
+
+        private static async Task WaitForFileAsync(string path, TimeSpan timeout)
+        {
+            var deadline = DateTime.UtcNow + timeout;
+            while (!File.Exists(path))
+            {
+                if (DateTime.UtcNow >= deadline)
+                {
+                    throw new TimeoutException(
+                        $"dotnet-trace was not launched; expected argument log at {path}");
+                }
+                await Task.Delay(50);
+            }
+        }
+
+        private static void WriteFakeDotNetTrace(string path)
+        {
+            const string script = """
+#!/usr/bin/env bash
+set -u
+
+if [[ "${1:-}" == "--version" ]]; then
+  printf '%s\n' '10.0.721401'
+  exit 0
+fi
+
+printf '%s\n' "$@" > "$PWD/dotnet-trace.args"
+
+output=""
+previous=""
+for argument in "$@"; do
+  if [[ "$previous" == "-o" || "$previous" == "--output" ]]; then
+    output="$argument"
+  fi
+  previous="$argument"
+done
+
+if [[ -f "$PWD/.write-partial" && -n "$output" ]]; then
+  printf '%s\n' 'partial trace' > "$output"
+fi
+
+on_sigint() {
+  : > "$PWD/dotnet-trace.sigint"
+  if [[ ! -f "$PWD/.ignore-sigint" ]]; then
+    if [[ -n "$output" ]]; then
+      printf '%s\n' 'completed trace' > "$output"
+    fi
+    exit 0
+  fi
+}
+
+trap on_sigint INT
+while true; do
+  sleep 0.1
+done
+""";
+
+            File.WriteAllText(path, script);
+            File.SetUnixFileMode(
+                path,
+                UnixFileMode.UserRead |
+                UnixFileMode.UserWrite |
+                UnixFileMode.UserExecute);
+        }
+    }
+}
