+        [Fact]
+        public async Task FinalizationTimeoutKeepsAnExistingPartialTrace()
+        {
+            using var run = await DotNetTraceProcessRun.StartAsync(
+                mode: "collect-linux",
+                providers: "cpu-sampling",
+                stopTimeoutSec: 1,
+                writePartialTrace: true,
+                ignoreSigInt: true);
