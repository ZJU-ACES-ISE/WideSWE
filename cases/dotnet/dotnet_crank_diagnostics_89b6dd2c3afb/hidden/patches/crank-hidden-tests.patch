+        [Fact]
+        public async Task CollectLinuxNonRootAgentFailsWithoutFallingBack()
+        {
+            if (!System.OperatingSystem.IsLinux())
+            {
+                return;
+            }
+
+            var setpriv = FindOnPath("setpriv");
+            Assert.True(
+                setpriv != null,
+                "The Linux test image must provide setpriv for the non-root preflight check.");
+
+            var port = GetUnusedTcpPort();
+            var workingDirectory = Path.Combine(
+                Path.GetTempPath(),
+                "crank-collect-linux-preflight-" + Guid.NewGuid().ToString("N"));
+            Directory.CreateDirectory(workingDirectory);
+            MakeWorldWritable(workingDirectory);
+
+            var agentProject = Path.GetFullPath(
+                Path.Combine(
+                    AppContext.BaseDirectory,
+                    "../../../../../src/Microsoft.Crank.Agent/Microsoft.Crank.Agent.csproj"));
+            Assert.True(File.Exists(agentProject), $"Agent project not found at {agentProject}");
+
+            var startInfo = new ProcessStartInfo
+            {
+                FileName = setpriv,
+                WorkingDirectory = workingDirectory,
+                RedirectStandardOutput = true,
+                RedirectStandardError = true,
+                UseShellExecute = false,
+            };
+            startInfo.ArgumentList.Add("--reuid=65534");
+            startInfo.ArgumentList.Add("--regid=65534");
+            startInfo.ArgumentList.Add("--clear-groups");
+            startInfo.ArgumentList.Add("dotnet");
+            startInfo.ArgumentList.Add("run");
+            startInfo.ArgumentList.Add("--no-build");
+            startInfo.ArgumentList.Add("--framework");
+            startInfo.ArgumentList.Add("net8.0");
+            startInfo.ArgumentList.Add("--project");
+            startInfo.ArgumentList.Add(agentProject);
+            startInfo.ArgumentList.Add("--");
+            startInfo.ArgumentList.Add("--url");
+            startInfo.ArgumentList.Add($"http://127.0.0.1:{port}");
+            startInfo.ArgumentList.Add("--dotnethome");
+            startInfo.ArgumentList.Add(workingDirectory);
+            startInfo.Environment["HOME"] = workingDirectory;
+            startInfo.Environment["DOTNET_CLI_HOME"] = workingDirectory;
+            startInfo.Environment["DOTNET_SKIP_FIRST_TIME_EXPERIENCE"] = "1";
+
+            using var agent = Process.Start(startInfo);
+            Assert.NotNull(agent);
+
+            try
+            {
+                using var client = new HttpClient
+                {
+                    BaseAddress = new Uri($"http://127.0.0.1:{port}"),
+                    Timeout = TimeSpan.FromSeconds(2),
+                };
+                await WaitForAgentAsync(client, agent);
+
+                const string jobJson = """
+{
+  "DriverVersion": 2,
+  "State": "New",
+  "Service": "hidden-preflight",
+  "DotNetTrace": true,
+  "DotNetTraceCollectMode": "collect-linux"
+}
+""";
+                using var response = await client.PostAsync(
+                    "/jobs",
+                    new StringContent(jobJson, Encoding.UTF8, "application/json"));
+                Assert.Equal(HttpStatusCode.Accepted, response.StatusCode);
+
+                var job = await WaitForFailedJobAsync(client, agent);
+                Assert.Contains("collect-linux", job, StringComparison.OrdinalIgnoreCase);
+                Assert.Contains("effective UID 0", job, StringComparison.OrdinalIgnoreCase);
+                Assert.Contains("kernel", job, StringComparison.OrdinalIgnoreCase);
+                Assert.Contains("collect", job, StringComparison.OrdinalIgnoreCase);
+            }
+            finally
+            {
+                if (!agent.HasExited)
+                {
+                    agent.Kill(entireProcessTree: true);
+                    await agent.WaitForExitAsync();
+                }
+            }
+        }
+
+        private static void AssertFlagContains(
+            IReadOnlyList<string> arguments,
+            string flag,
+            string expectedToken)
+        {
+            Assert.Contains(
+                ValuesForFlag(arguments, flag).SelectMany(SplitOptionValue),
+                token => string.Equals(token, expectedToken, StringComparison.OrdinalIgnoreCase));
+        }
+
+        private static void AssertFlagDoesNotContain(
+            IReadOnlyList<string> arguments,
+            string flag,
+            string unexpectedToken)
+        {
+            Assert.DoesNotContain(
+                ValuesForFlag(arguments, flag).SelectMany(SplitOptionValue),
+                token => string.Equals(token, unexpectedToken, StringComparison.OrdinalIgnoreCase));
+        }
+
+        private static IEnumerable<string> ValuesForFlag(
+            IReadOnlyList<string> arguments,
+            string flag)
+        {
+            for (var i = 0; i < arguments.Count - 1; i++)
+            {
+                if (string.Equals(arguments[i], flag, StringComparison.OrdinalIgnoreCase))
+                {
+                    yield return arguments[i + 1];
+                }
+            }
+        }
+
+        private static IEnumerable<string> SplitOptionValue(string value) =>
+            value.Split(new[] { ',', '+' }, StringSplitOptions.RemoveEmptyEntries)
+                .Select(token => token.Trim());
+
+        private static async Task WaitForAgentAsync(HttpClient client, Process agent)
+        {
+            var deadline = DateTime.UtcNow + TimeSpan.FromSeconds(15);
+            while (DateTime.UtcNow < deadline)
+            {
+                ThrowIfExited(agent);
+                try
+                {
+                    using var response = await client.GetAsync("/jobs/info");
+                    if (response.IsSuccessStatusCode)
+                    {
+                        return;
+                    }
+                }
+                catch (HttpRequestException)
+                {
+                }
+                catch (TaskCanceledException)
+                {
+                }
+
+                await Task.Delay(100);
+            }
+
+            throw new TimeoutException("The Crank agent did not start in time.");
+        }
+
+        private static async Task<string> WaitForFailedJobAsync(HttpClient client, Process agent)
+        {
+            var deadline = DateTime.UtcNow + TimeSpan.FromSeconds(12);
+            while (DateTime.UtcNow < deadline)
+            {
+                ThrowIfExited(agent);
+                try
+                {
+                    using var response = await client.GetAsync("/jobs/1");
+                    if (response.IsSuccessStatusCode)
+                    {
+                        var body = await response.Content.ReadAsStringAsync();
+                        if (body.Contains("\"State\":\"Failed\"", StringComparison.OrdinalIgnoreCase) ||
+                            body.Contains("\"state\":\"Failed\"", StringComparison.OrdinalIgnoreCase))
+                        {
+                            return body;
+                        }
+                    }
+                }
+                catch (HttpRequestException)
+                {
+                }
+                catch (TaskCanceledException)
+                {
+                }
+
+                await Task.Delay(100);
+            }
+
+            throw new TimeoutException("collect-linux did not fail its non-root preflight in time.");
+        }
+
+        private static void ThrowIfExited(Process process)
+        {
+            if (!process.HasExited)
+            {
+                return;
+            }
+
+            var stdout = process.StandardOutput.ReadToEnd();
+            var stderr = process.StandardError.ReadToEnd();
+            throw new InvalidOperationException(
+                $"Crank agent exited unexpectedly ({process.ExitCode}).\nstdout:\n{stdout}\nstderr:\n{stderr}");
+        }
+
+        private static string FindOnPath(string executable)
+        {
+            foreach (var directory in (Environment.GetEnvironmentVariable("PATH") ?? "")
+                         .Split(Path.PathSeparator, StringSplitOptions.RemoveEmptyEntries))
+            {
+                var candidate = Path.Combine(directory, executable);
+                if (File.Exists(candidate))
+                {
+                    return candidate;
+                }
+            }
+            return null;
+        }
+
+        private static int GetUnusedTcpPort()
+        {
+            using var listener = new TcpListener(IPAddress.Loopback, 0);
+            listener.Start();
+            return ((IPEndPoint)listener.LocalEndpoint).Port;
+        }
+
+        private static void MakeWorldWritable(string path)
+        {
+            File.SetUnixFileMode(
+                path,
+                UnixFileMode.UserRead |
+                UnixFileMode.UserWrite |
+                UnixFileMode.UserExecute |
+                UnixFileMode.GroupRead |
+                UnixFileMode.GroupWrite |
+                UnixFileMode.GroupExecute |
+                UnixFileMode.OtherRead |
+                UnixFileMode.OtherWrite |
+                UnixFileMode.OtherExecute);
+        }
+    }
