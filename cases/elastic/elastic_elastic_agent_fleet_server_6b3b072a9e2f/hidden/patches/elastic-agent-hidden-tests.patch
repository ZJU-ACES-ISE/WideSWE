+package fleet
+
+import (
+	"compress/gzip"
+	"context"
+	"encoding/json"
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+
+	"github.com/elastic/elastic-agent-libs/config"
+	"github.com/elastic/elastic-agent/internal/pkg/agent/configuration"
+	"github.com/elastic/elastic-agent/internal/pkg/fleetapi/acker/noop"
+	"github.com/elastic/elastic-agent/pkg/core/logger"
+	"github.com/stretchr/testify/require"
+)
+
+func TestFleetCheckinCompressionWireContract(t *testing.T) {
+	tests := []struct {
+		name            string
+		compression     string
+		wantContentGzip bool
+	}{
+		{name: "default", wantContentGzip: true},
+		{name: "gzip", compression: "gzip", wantContentGzip: true},
+		{name: "none", compression: "none", wantContentGzip: false},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			checkinConfig := &configuration.FleetCheckin{}
+			if tc.compression != "" {
+				raw := config.MustNewConfigFrom(map[string]any{"compression": tc.compression})
+				require.NoError(t, raw.Unpack(checkinConfig))
+			}
+
+			testClient := newTestingClient()
+			testClient.Answer(func(_ context.Context, headers http.Header, body io.Reader) (*http.Response, error) {
+				requestBody := body
+				if tc.wantContentGzip {
+					require.Equal(t, "gzip", headers.Get("Content-Encoding"))
+					reader, err := gzip.NewReader(body)
+					require.NoError(t, err)
+					defer reader.Close()
+					requestBody = reader
+				} else {
+					require.Empty(t, headers.Get("Content-Encoding"))
+				}
+
+				var payload map[string]any
+				require.NoError(t, json.NewDecoder(requestBody).Decode(&payload))
+				return &http.Response{
+					StatusCode: http.StatusOK,
+					Body:       io.NopCloser(strings.NewReader(`{"actions":[]}`)),
+					Header:     make(http.Header),
+				}, nil
+			})
+
+			log, err := logger.New("checkin_compression_contract", false)
+			require.NoError(t, err)
+			stateStore := newStateStore(t, log)
+			rollbacks := newMockRollbacksSource(t)
+			rollbacks.EXPECT().Get().Return(nil, nil)
+
+			gateway, err := New(
+				log,
+				new(testAgentInfo),
+				testClient,
+				noop.New(),
+				stateStore,
+				NewCheckinStateFetcher(emptyStateFetcher),
+				checkinConfig,
+				rollbacks,
+			)
+			require.NoError(t, err)
+			_, _, err = gateway.execute(t.Context())
+			require.NoError(t, err)
+		})
+	}
+}
