+// you may not use this file except in compliance with the Elastic License 2.0.
+
+package configuration
+
+import (
+	"testing"
+
+	"github.com/elastic/elastic-agent-libs/config"
+	"github.com/stretchr/testify/require"
+)
+
+func TestFleetCheckinCompressionConfigContract(t *testing.T) {
+	for _, compression := range []string{"none", "gzip"} {
+		t.Run(compression, func(t *testing.T) {
+			checkin, err := unpackCheckinCompression(compression)
+			require.NoError(t, err)
+			require.NoError(t, checkin.Validate())
+		})
+	}
+
+	t.Run("unsupported", func(t *testing.T) {
+		checkin, err := unpackCheckinCompression("deflate")
+		if err == nil {
+			err = checkin.Validate()
+		}
+		require.Error(t, err)
+	})
+}
+
+func unpackCheckinCompression(compression string) (*FleetCheckin, error) {
+	raw, err := config.NewConfigFrom(map[string]any{"compression": compression})
+	if err != nil {
+		return nil, err
+	}
+
+	checkin := &FleetCheckin{}
+	if err := raw.Unpack(checkin); err != nil {
+		return nil, err
+	}
+	return checkin, nil
+}
