+
+func TestQualifiedInputFleetPolicyContract(t *testing.T) {
+	manifest, err := packages.ReadPackageManifestBytes([]byte(`
+format_version: 3.6.0
+name: qualified_integration
+title: Qualified integration
+description: Qualified integration fixture.
+version: 0.1.0
+type: integration
+policy_templates:
+  - name: qualified
+    title: Qualified
+    description: Qualified policy template.
+    data_streams:
+      - qualified_logs
+      - qualified_metrics
+    inputs:
+      - name: qualified_logs_input
+        type: otelcol
+        title: Logs input
+      - name: qualified_metrics_input
+        type: otelcol
+        title: Metrics input
+`))
+	require.NoError(t, err)
+	require.Len(t, manifest.PolicyTemplates, 1)
+
+	logs := readQualifiedPolicyDataStream(t, `
+name: qualified_logs
+title: Qualified logs
+type: logs
+dataset: qualified_integration.logs
+streams:
+  - input: qualified_logs_input
+    title: Qualified logs stream
+`)
+	metrics := readQualifiedPolicyDataStream(t, `
+name: qualified_metrics
+title: Qualified metrics
+type: metrics
+dataset: qualified_integration.metrics
+streams:
+  - input: qualified_metrics_input
+    title: Qualified metrics stream
+`)
+
+	policy, err := BuildIntegrationPackagePolicy(
+		"policy-id",
+		"default",
+		"qualified-policy",
+		*manifest,
+		manifest.PolicyTemplates[0],
+		logs,
+		"qualified_logs_input",
+		common.MapStr{},
+		common.MapStr{},
+		true,
+		[]packages.DataStreamManifest{logs, metrics},
+	)
+	require.NoError(t, err)
+	require.Len(t, policy.Inputs, 2, "same-type inputs must not overwrite each other")
+
+	legacy := policy.toLegacy()
+	require.Len(t, legacy.Inputs, 1)
+	require.Equal(t, "otelcol", legacy.Inputs[0].Type)
+	require.Len(t, legacy.Inputs[0].Streams, 1)
+	require.Equal(t, "qualified_integration.logs", legacy.Inputs[0].Streams[0].DataStream.Dataset)
+}
+
+func readQualifiedPolicyDataStream(t *testing.T, contents string) packages.DataStreamManifest {
+	t.Helper()
+	manifest, err := packages.ReadDataStreamManifestBytes([]byte(contents))
+	require.NoError(t, err)
+	return *manifest
+}
diff --git a/internal/qualifiedinputcontract/requiredinputs_contract_test.go b/internal/qualifiedinputcontract/requiredinputs_contract_test.go
