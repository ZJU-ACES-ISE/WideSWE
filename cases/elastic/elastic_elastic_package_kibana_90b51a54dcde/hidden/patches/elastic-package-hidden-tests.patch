+++ b/internal/qualifiedinputcontract/requiredinputs_contract_test.go
@@ -0,0 +1,181 @@
+// Copyright Elasticsearch B.V. and/or licensed to Elasticsearch B.V. under one
+// or more contributor license agreements. Licensed under the Elastic License;
+// you may not use this file except in compliance with the Elastic License.
+
+package qualifiedinputcontract
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"gopkg.in/yaml.v3"
+
+	"github.com/elastic/elastic-package/internal/requiredinputs"
+)
+
+type qualifiedInputEPRClient struct {
+	packageDirs map[string]string
+}
+
+func (c qualifiedInputEPRClient) DownloadPackage(packageName, _, _ string) (string, error) {
+	packageDir, ok := c.packageDirs[packageName]
+	if !ok {
+		return "", fmt.Errorf("unknown input package %q", packageName)
+	}
+	return packageDir, nil
+}
+
+type qualifiedInputContractManifest struct {
+	PolicyTemplates []struct {
+		Inputs []struct {
+			Name    string `yaml:"name"`
+			Type    string `yaml:"type"`
+			Package string `yaml:"package"`
+		} `yaml:"inputs"`
+	} `yaml:"policy_templates"`
+}
+
+type qualifiedInputContractDataStream struct {
+	Streams []struct {
+		Input   string `yaml:"input"`
+		Package string `yaml:"package"`
+	} `yaml:"streams"`
+}
+
+type qualifiedInputContractResult struct {
+	inputNames  []string
+	inputTypes  []string
+	streamRefs  []string
+	packageRefs []string
+}
+
+func TestQualifiedInputBundleContract(t *testing.T) {
+	t.Run("duplicate types use stable qualifiers", func(t *testing.T) {
+		first := runQualifiedInputBundle(t, []string{"otelcol", "otelcol"})
+		second := runQualifiedInputBundle(t, []string{"otelcol", "otelcol"})
+
+		require.Equal(t, []string{"otelcol", "otelcol"}, first.inputTypes)
+		require.Len(t, first.inputNames, 2)
+		require.NotEmpty(t, first.inputNames[0])
+		require.NotEmpty(t, first.inputNames[1])
+		require.NotEqual(t, first.inputNames[0], first.inputNames[1])
+		require.ElementsMatch(t, first.inputNames, first.streamRefs)
+		require.Equal(t, first.inputNames, second.inputNames)
+		require.Equal(t, []string{"", "", "", ""}, first.packageRefs)
+	})
+
+	t.Run("unique types preserve type references", func(t *testing.T) {
+		result := runQualifiedInputBundle(t, []string{"logfile", "winlog"})
+		require.Equal(t, []string{"", ""}, result.inputNames)
+		require.Equal(t, []string{"logfile", "winlog"}, result.inputTypes)
+		require.ElementsMatch(t, result.inputTypes, result.streamRefs)
+		require.Equal(t, []string{"", "", "", ""}, result.packageRefs)
+	})
+}
+
+func runQualifiedInputBundle(t *testing.T, inputTypes []string) qualifiedInputContractResult {
+	t.Helper()
+	require.Len(t, inputTypes, 2)
+
+	packageNames := []string{"qualified_logs_pkg", "qualified_metrics_pkg"}
+	packageDirs := make(map[string]string, len(packageNames))
+	for i, packageName := range packageNames {
+		packageDir := t.TempDir()
+		writeQualifiedInputContractFile(t, filepath.Join(packageDir, "manifest.yml"), `
+name: `+packageName+`
+title: Qualified input
+description: Qualified input fixture.
+version: 0.1.0
+type: input
+policy_templates:
+  - name: input
+    input: `+inputTypes[i]+`
+    type: logs
+`)
+		packageDirs[packageName] = packageDir
+	}
+
+	buildRoot := t.TempDir()
+	writeQualifiedInputContractFile(t, filepath.Join(buildRoot, "manifest.yml"), `
+format_version: 3.6.0
+name: qualified_integration
+title: Qualified integration
+description: Qualified integration fixture.
+version: 0.1.0
+type: integration
+requires:
+  input:
+    - package: qualified_logs_pkg
+      version: 0.1.0
+    - package: qualified_metrics_pkg
+      version: 0.1.0
+policy_templates:
+  - name: qualified
+    title: Qualified
+    description: Qualified policy template.
+    data_streams:
+      - qualified_logs
+      - qualified_metrics
+    inputs:
+      - package: qualified_logs_pkg
+        title: Logs input
+      - package: qualified_metrics_pkg
+        title: Metrics input
+`)
+
+	dataStreams := []string{"qualified_logs", "qualified_metrics"}
+	for i, dataStream := range dataStreams {
+		dataStreamDir := filepath.Join(buildRoot, "data_stream", dataStream)
+		require.NoError(t, os.MkdirAll(dataStreamDir, 0o755))
+		writeQualifiedInputContractFile(t, filepath.Join(dataStreamDir, "manifest.yml"), `
+title: Qualified stream
+type: logs
+streams:
+  - package: `+packageNames[i]+`
+    title: Qualified stream
+`)
+	}
+
+	epr := qualifiedInputEPRClient{packageDirs: packageDirs}
+	require.NoError(t, requiredinputs.NewRequiredInputsResolver(epr).Bundle(buildRoot))
+
+	var manifest qualifiedInputContractManifest
+	readQualifiedInputContractYAML(t, filepath.Join(buildRoot, "manifest.yml"), &manifest)
+	require.Len(t, manifest.PolicyTemplates, 1)
+	require.Len(t, manifest.PolicyTemplates[0].Inputs, 2)
+
+	result := qualifiedInputContractResult{}
+	for _, input := range manifest.PolicyTemplates[0].Inputs {
+		result.inputNames = append(result.inputNames, input.Name)
+		result.inputTypes = append(result.inputTypes, input.Type)
+		result.packageRefs = append(result.packageRefs, input.Package)
+	}
+	for _, dataStream := range dataStreams {
+		var manifest qualifiedInputContractDataStream
+		readQualifiedInputContractYAML(t, filepath.Join(buildRoot, "data_stream", dataStream, "manifest.yml"), &manifest)
+		require.Len(t, manifest.Streams, 1)
+		result.streamRefs = append(result.streamRefs, manifest.Streams[0].Input)
+		result.packageRefs = append(result.packageRefs, manifest.Streams[0].Package)
+	}
+
+	sort.Strings(result.inputNames)
+	sort.Strings(result.inputTypes)
+	sort.Strings(result.streamRefs)
+	return result
+}
+
+func writeQualifiedInputContractFile(t *testing.T, path, contents string) {
+	t.Helper()
+	require.NoError(t, os.WriteFile(path, []byte(contents), 0o644))
+}
+
+func readQualifiedInputContractYAML(t *testing.T, path string, target any) {
+	t.Helper()
+	contents, err := os.ReadFile(path)
+	require.NoError(t, err)
+	require.NoError(t, yaml.Unmarshal(contents, target))
+}
