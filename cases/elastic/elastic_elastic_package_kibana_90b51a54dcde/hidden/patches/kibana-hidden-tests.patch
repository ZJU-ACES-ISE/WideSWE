+import type { PackageInfo } from '../types';
+
+import { packageToPackagePolicyInputs } from './package_to_package_policy';
+
+type ContractPolicyInput = {
+  name?: string;
+  type: string;
+  streams: Array<{ data_stream: { dataset: string } }>;
+};
+
+describe('qualified input policy contract', () => {
+  it('keeps same-type named inputs distinct and matches streams by name', () => {
+    const packageInfo = {
+      name: 'qualified-integration',
+      title: 'Qualified integration',
+      version: '1.0.0',
+      type: 'integration',
+      policy_templates: [
+        {
+          name: 'qualified',
+          data_streams: ['logs', 'metrics'],
+          inputs: [
+            { name: 'qualified_logs_input', type: 'otelcol', title: 'Logs input' },
+            { name: 'qualified_metrics_input', type: 'otelcol', title: 'Metrics input' },
+          ],
+        },
+      ],
+      data_streams: [
+        {
+          type: 'logs',
+          dataset: 'qualified.logs',
+          path: 'logs',
+          streams: [{ input: 'qualified_logs_input', title: 'Logs stream' }],
+        },
+        {
+          type: 'metrics',
+          dataset: 'qualified.metrics',
+          path: 'metrics',
+          streams: [{ input: 'qualified_metrics_input', title: 'Metrics stream' }],
+        },
+      ],
+    } as unknown as PackageInfo;
+
+    const result = packageToPackagePolicyInputs(packageInfo) as ContractPolicyInput[];
+    expect(result).toHaveLength(2);
+
+    const logs = result.find((input) => input.name === 'qualified_logs_input');
+    const metrics = result.find((input) => input.name === 'qualified_metrics_input');
+    expect(logs).toMatchObject({ type: 'otelcol' });
+    expect(metrics).toMatchObject({ type: 'otelcol' });
+    expect(logs?.streams.map((stream) => stream.data_stream.dataset)).toEqual(['qualified.logs']);
+    expect(metrics?.streams.map((stream) => stream.data_stream.dataset)).toEqual([
+      'qualified.metrics',
+    ]);
+  });
+
+  it('preserves type-based matching when no qualifier is present', () => {
+    const packageInfo = {
+      name: 'legacy-integration',
+      title: 'Legacy integration',
+      version: '1.0.0',
+      type: 'integration',
+      policy_templates: [
+        {
+          name: 'legacy',
+          data_streams: ['logs'],
+          inputs: [{ type: 'logfile', title: 'Log file input' }],
+        },
+      ],
+      data_streams: [
+        {
+          type: 'logs',
+          dataset: 'legacy.logs',
+          path: 'logs',
+          streams: [{ input: 'logfile', title: 'Logs stream' }],
+        },
+      ],
+    } as unknown as PackageInfo;
+
+    const result = packageToPackagePolicyInputs(packageInfo) as ContractPolicyInput[];
+    expect(result).toHaveLength(1);
+    expect(result[0]).toMatchObject({ type: 'logfile' });
+    expect(result[0].name).toBeUndefined();
+    expect(result[0].streams.map((stream) => stream.data_stream.dataset)).toEqual(['legacy.logs']);
+  });
+});
