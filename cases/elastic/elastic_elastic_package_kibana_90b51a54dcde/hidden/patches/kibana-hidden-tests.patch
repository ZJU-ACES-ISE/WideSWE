+import React from 'react';
+
+import { createIntegrationsTestRendererMock } from '../../../../../../../mock';
+import type { PackageInfo } from '../../../../../types';
+
+import { DocumentationPage } from '.';
+
+jest.mock('../../../../../../../hooks', () => ({
+  ...jest.requireActual('../../../../../../../hooks'),
+  useStartServices: jest.fn().mockReturnValue({
+    docLinks: { links: { fleet: { api: 'https://example.test/fleet-api' } } },
+  }),
+}));
+
+describe('qualified input API reference', () => {
+  it('shows same-type inputs separately with only their referenced streams', () => {
+    const packageInfo = {
+      name: 'qualified',
+      title: 'Qualified inputs',
+      version: '1.0.0',
+      description: 'Qualified input contract fixture',
+      format_version: '3.6.0',
+      owner: { github: 'elastic' },
+      assets: {},
+      policy_templates: [
+        {
+          name: 'qualified',
+          title: 'Qualified inputs',
+          description: 'Qualified inputs',
+          inputs: [
+            {
+              name: 'logs_input',
+              type: 'otelcol',
+              title: 'Logs input',
+              description: 'Collect logs',
+            },
+            {
+              name: 'metrics_input',
+              type: 'otelcol',
+              title: 'Metrics input',
+              description: 'Collect metrics',
+            },
+          ],
+          multiple: true,
+        },
+      ],
+      data_streams: [
+        {
+          type: 'logs',
+          dataset: 'qualified.logs',
+          title: 'Qualified logs',
+          release: 'ga',
+          package: 'qualified',
+          path: 'logs',
+          streams: [
+            {
+              input: 'logs_input',
+              title: 'Logs stream',
+              description: 'Logs stream',
+              template_path: 'stream.yml.hbs',
+            },
+          ],
+        },
+        {
+          type: 'metrics',
+          dataset: 'qualified.metrics',
+          title: 'Qualified metrics',
+          release: 'ga',
+          package: 'qualified',
+          path: 'metrics',
+          streams: [
+            {
+              input: 'metrics_input',
+              title: 'Metrics stream',
+              description: 'Metrics stream',
+              template_path: 'stream.yml.hbs',
+            },
+          ],
+        },
+      ],
+      latestVersion: '1.0.0',
+      keepPoliciesUpToDate: false,
+      status: 'not_installed',
+    } as unknown as PackageInfo;
+
+    const renderer = createIntegrationsTestRendererMock();
+    const result = renderer.render(<DocumentationPage packageInfo={packageInfo} />);
+
+    expect(
+      result.getByText((content, element) =>
+        Boolean(element?.matches('code') && content.includes('logs_input'))
+      )
+    ).toBeInTheDocument();
+    expect(
+      result.getByText((content, element) =>
+        Boolean(element?.matches('code') && content.includes('metrics_input'))
+      )
+    ).toBeInTheDocument();
+    expect(result.getAllByText('qualified.logs')).toHaveLength(1);
+    expect(result.getAllByText('qualified.metrics')).toHaveLength(1);
+  });
+});
