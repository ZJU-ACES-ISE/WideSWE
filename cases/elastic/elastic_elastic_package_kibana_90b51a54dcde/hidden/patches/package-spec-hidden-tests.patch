index 0000000000000000000000000000000000000000..dd7de222cb9fd83406556669bb17be18815ea56c
--- /dev/null
+++ b/code/go/pkg/validator/qualified_input_contract_test.go
@@ -0,0 +1,35 @@
+// Copyright Elasticsearch B.V. and/or licensed to Elasticsearch B.V. under one
+// or more contributor license agreements. Licensed under the Elastic License;
+// you may not use this file except in compliance with the Elastic License.
+
+package validator
+
+import (
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestQualifiedInputPackageContract(t *testing.T) {
+	packagesRoot := filepath.Join("..", "..", "..", "..", "test", "packages")
+	tests := []struct {
+		name  string
+		valid bool
+	}{
+		{name: "good_input_qualifier", valid: true},
+		{name: "bad_input_qualifier_ambiguous", valid: false},
+		{name: "bad_input_qualifier_old_version", valid: false},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			err := ValidateFromPath(filepath.Join(packagesRoot, test.name))
+			if test.valid {
+				require.NoError(t, err)
+				return
+			}
+			require.Error(t, err)
+		})
+	}
+}
