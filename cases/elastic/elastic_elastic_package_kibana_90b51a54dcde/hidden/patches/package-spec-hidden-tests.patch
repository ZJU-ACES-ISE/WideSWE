+name: bad_input_qualifier_ambiguous
+title: "Bad package with ambiguous inputs"
+version: 0.0.1
+source:
+  license: "Apache-2.0"
+description: "Integration package with multiple inputs of the same type without names."
+type: integration
+categories:
+  - observability
+conditions:
+  kibana:
+    version: "^9.4.0"
+  elastic:
+    subscription: "basic"
