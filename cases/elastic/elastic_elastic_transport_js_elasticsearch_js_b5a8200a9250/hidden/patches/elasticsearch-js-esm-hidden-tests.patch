+const require = createRequire(import.meta.url)
+
+test('ESM package import exposes usable public APIs', async (t) => {
+  const elasticsearch = await import('@elastic/elasticsearch')
+
+  for (const exported of [
+    'Client',
+    'SniffingTransport',
+    'Transport',
+    'Diagnostic',
+    'Serializer',
+    'BaseConnection',
+    'HttpConnection',
+    'UndiciConnection',
+    'BaseConnectionPool',
+    'ClusterConnectionPool',
+    'CloudConnectionPool',
+    'WeightedConnectionPool',
+    'errors',
+    'events'
+  ]) {
+    t.ok(elasticsearch[exported], `${exported} is exported`)
   }
+
+  const client = new elasticsearch.Client({
+    node: 'http://localhost:9200',
+    auth: {
+      username: 'elastic',
+      password: 'changeme'
+    }
+  })
+  const serializer = new elasticsearch.Serializer()
+
+  t.ok(client)
+  t.equal(typeof serializer.serialize, 'function')
+  t.equal(typeof serializer.deserialize, 'function')
+})
+
+test('import and require use distinct package entry points', async (t) => {
+  const esmEntry = import.meta.resolve('@elastic/elasticsearch')
+  const cjsEntry = pathToFileURL(require.resolve('@elastic/elasticsearch')).href
+
+  t.not(esmEntry, cjsEntry)
 })
