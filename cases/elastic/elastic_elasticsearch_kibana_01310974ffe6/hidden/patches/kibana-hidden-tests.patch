+
+        it('should protect non-dynamic connectors', () => {
+          const existingConnector = pluginStart.inMemoryConnectors[0];
+
+          expect(pluginStart.unregisterDynamicConnector(existingConnector.id)).toBe(false);
+          expect(pluginStart.inMemoryConnectors).toContainEqual(existingConnector);
+        });
