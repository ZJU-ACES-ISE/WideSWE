+    private List<List<Object>> executeLocalQuery(String query) throws Exception {
+        Configuration configuration = config();
+        var analyzer = org.elasticsearch.xpack.esql.EsqlTestUtils.analyzer().configuration(configuration).buildAnalyzer();
+        var physicalPlan = new TestPlannerOptimizer(configuration, analyzer).plan(query);
+        var executionPlan = planner(configuration, null).plan(
+            "change_point_by",
+            FoldContext.small(),
+            PlannerSettings.DEFAULTS,
+            physicalPlan,
+            EmptyIndexedByShardId.instance()
+        );
+        assertThat(executionPlan.driverFactories, hasSize(1));
+
+        var operation = executionPlan.driverFactories.get(0).driverSupplier().physicalOperation();
+        DriverContext driverContext = new DriverContext(
+            BigArrays.NON_RECYCLING_INSTANCE,
+            TestBlockFactory.getNonBreakingInstance(),
+            null
+        );
+        List<Operator> operators = new ArrayList<>();
+        operation.operators(operators, driverContext);
+        List<Page> pages = new ArrayList<>();
+        try (
+            Driver driver = TestDriverFactory.create(
+                driverContext,
+                operation.source(driverContext),
+                operators,
+                new TestResultPageSinkOperator(pages::add)
+            )
+        ) {
+            new TestDriverRunner().run(driver);
+        }
+
+        try {
+            List<List<Object>> rows = new ArrayList<>();
+            for (Page page : pages) {
+                for (int position = 0; position < page.getPositionCount(); position++) {
+                    List<Object> row = new ArrayList<>();
+                    for (int block = 0; block < page.getBlockCount(); block++) {
+                        Object value = BlockUtils.toJavaObject(page.getBlock(block), position);
+                        row.add(value instanceof BytesRef bytes ? bytes.utf8ToString() : value);
+                    }
+                    rows.add(row);
+                }
+            }
+            return rows;
+        } finally {
+            pages.forEach(Page::releaseBlocks);
+        }
+    }
