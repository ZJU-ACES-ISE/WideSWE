+                FROM test
+                | WHERE color IN (FROM test | WHERE id == 7 | KEEP color) OR id > 4
+                | SORT id
+                | KEEP id
+                """,
+            // Subquery has SV "red" + the MV row. Dedup is {NULL, "red"}; mark is TRUE for
+            // "red" rows, NULL for "blue"/MV rows. Combined with OR `id > 100`: only the
