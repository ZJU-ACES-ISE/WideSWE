+                | SORT id
+                | KEEP id
+                """,
+            // Same subquery as above but the OR's other side is TRUE for some rows → mark is
+            // NULL, NULL OR TRUE = TRUE → those rows are kept; otherwise NULL OR FALSE = NULL
