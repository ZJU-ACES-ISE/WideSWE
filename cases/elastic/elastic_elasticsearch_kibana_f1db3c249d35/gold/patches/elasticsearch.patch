+        typesToIndices.put("integer", Set.of("union_index_2"));
+        EsField idField = new InvalidMappedField("id", typesToIndices);
+        EsField nameField = new EsField("name", DataType.KEYWORD, Map.of(), true, EsField.TimeSeriesFieldType.NONE);
