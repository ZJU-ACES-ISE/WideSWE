+// (IN sub1 AND gender == "M") OR (IN sub2 AND salary > 70000) OR (NOT IN sub3 AND gender == "F")
+// Three disjuncts, each containing an IN/NOT IN subquery wrapped in AND with an extra predicate.
+// Produces three LeftSemiJoin nodes stacked below a single Filter that ORs the three marks.
+threeWayDisjunctiveInSubqueriesWithPredicates
+required_capability: where_in_subquery_without_view
+
+FROM employees
+| WHERE (emp_no IN (FROM employees | WHERE languages == 1 | KEEP emp_no) AND gender == "M")
+     OR (emp_no IN (FROM employees | WHERE salary > 73000 | KEEP emp_no) AND salary > 70000)
+     OR (emp_no NOT IN (FROM employees | WHERE salary > 30000 | KEEP emp_no) AND gender == "F")
