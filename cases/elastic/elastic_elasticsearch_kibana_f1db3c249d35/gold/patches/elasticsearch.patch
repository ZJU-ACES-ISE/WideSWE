+        assertThat(semiJoin.config().leftFields().size(), equalTo(1));
+        assertThat(semiJoin.config().leftFields().get(0).name(), equalTo("emp_no"));
+        assertThat(semiJoin.config().rightFields().size(), equalTo(1));
