+
+    // ---- nested IN subquery ----
+
+    public void testNestedInSubquery() {
+        try (var resp = run("""
+            FROM test
+            | WHERE id IN (
+                FROM test
+                | WHERE id IN (FROM test | WHERE color == "red" | KEEP id)
+                | WHERE id <= 3
+                | KEEP id
