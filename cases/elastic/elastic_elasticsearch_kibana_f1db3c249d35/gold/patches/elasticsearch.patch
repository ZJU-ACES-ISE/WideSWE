+nestedInSubqueryWithRowAsSourceInsideRowAsSourceSubquery
+required_capability: where_in_subquery_without_view
+required_capability: subquery_with_row
+
+// Nested IN-subquery where the inner WHERE-IN also uses a ROW as its
+// source. The inner ROW provides a literal x=1 that is used to filter
+// the outer employees subquery's rows.
+FROM employees
+| WHERE emp_no IN (
+    FROM employees
+    | WHERE 1 IN (ROW x = 1)
+    | SORT emp_no
+    | LIMIT 3
+    | KEEP emp_no
+  )
+| SORT emp_no
+| KEEP emp_no, first_name
+;
+
+emp_no:integer | first_name:keyword
+10001          | Georgi
+10002          | Bezalel
+10003          | Parto
+;
+
+rowOuterWithRowInSubqueryMatch
+required_capability: where_in_subquery_without_view
+required_capability: subquery_with_row
+
+ROW x = 1
+| WHERE x IN (ROW y = 1)
+;
