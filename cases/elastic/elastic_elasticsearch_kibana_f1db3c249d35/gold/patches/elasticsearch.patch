+// (IN sub1 OR languages == 1) AND (NOT IN sub2 OR salary > 65000)
+// Conjunction of two disjunctions, each containing an IN/NOT IN subquery — the LeftSemiJoin
+// approach evaluates each mark separately and the outer AND/OR machinery composes the result.
+conjunctionOfDisjunctiveInSubqueries
+required_capability: where_in_subquery_without_view
+
+FROM employees
+| WHERE (emp_no IN (FROM employees | WHERE salary > 70000 | KEEP emp_no) OR languages == 1)
+     AND (emp_no NOT IN (FROM employees | WHERE gender == "M" | KEEP emp_no) OR salary > 65000)
+| SORT emp_no
+| KEEP emp_no, gender, languages, salary
