diff --git a/packages/eui/src/components/flyout/flyout.test.tsx b/packages/eui/src/components/flyout/flyout.test.tsx
index 28b94f5197..c8e7451372 100644
--- a/packages/eui/src/components/flyout/flyout.test.tsx
