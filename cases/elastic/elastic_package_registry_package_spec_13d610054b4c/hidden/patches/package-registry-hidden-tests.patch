+format_version: 3.6.0
+name: deprecated_integration_input
+title: "New Package"
+version: 1.0.0
+source:
+  license: "Elastic-2.0"
+description: "This is a new package."
+type: integration
+categories:
+  - custom
+conditions:
+  kibana:
+    version: "^9.2.3"
+  elastic:
+    subscription: "basic"
+screenshots:
+  - src: /img/sample-screenshot.png
+    title: Sample screenshot
+    size: 600x600
+    type: image/png
+icons:
+  - src: /img/sample-logo.svg
+    title: Sample logo
+    size: 32x32
+    type: image/svg+xml
+policy_templates:
