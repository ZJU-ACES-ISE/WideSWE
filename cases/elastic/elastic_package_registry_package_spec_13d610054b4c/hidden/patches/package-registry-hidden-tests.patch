diff --git a/testdata/package/deprecated_input_package/1.0.0/manifest.yml b/testdata/package/deprecated_input_package/1.0.0/manifest.yml
new file mode 100644
index 00000000..80ec47ae
--- /dev/null
+++ b/testdata/package/deprecated_input_package/1.0.0/manifest.yml
@@ -0,0 +1,51 @@
+format_version: 3.6.0
+name: deprecated_input_package
+title: "New Package"
+version: 1.0.0
+source:
+  license: "Elastic-2.0"
+description: "This is a new package."
+type: input
+categories:
+  - custom
+conditions:
+  kibana:
+    version: "^9.2.3"
+  elastic:
+    subscription: "basic"
+screenshots:
+  - src: /img/sample-screenshot.png
+    title: Sample screenshot
+    size: 600x600
+    type: image/png
+icons:
+  - src: /img/sample-logo.svg
+    title: Sample logo
+    size: 32x32
+    type: image/svg+xml
+policy_templates:
+  - name: sample
+    type: logs
+    title: Sample logs
+    description: Collect sample logs
+    input: logfile
+    template_path: input.yml.hbs
+    vars:
+      - name: paths
+        type: text
+        title: Paths
+        multi: true
+        default:
+          - /var/log/*.log
+elasticsearch:
+  index_template:
+    mappings:
+      subobjects: false
+owner:
+  github: elastic/integrations
+  type: elastic
+deprecated:
+  since: 1.2.0
+  description: "This input package is deprecated"
+  replaced_by:
+    package: new_input_package
