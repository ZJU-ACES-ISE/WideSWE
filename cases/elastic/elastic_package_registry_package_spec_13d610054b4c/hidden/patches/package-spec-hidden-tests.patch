diff --git a/code/go/pkg/validator/deprecated_contract_test.go b/code/go/pkg/validator/deprecated_contract_test.go
new file mode 100644
index 0000000..171b046
--- /dev/null
+++ b/code/go/pkg/validator/deprecated_contract_test.go
@@ -0,0 +1,180 @@
+// Copyright Elasticsearch B.V. and/or licensed to Elasticsearch B.V. under one
+// or more contributor license agreements. Licensed under the Elastic License;
+// you may not use this file except in compliance with the Elastic License.
+
+package validator
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"testing"
+
+	cp "github.com/otiai10/copy"
+	"github.com/stretchr/testify/require"
+	"gopkg.in/yaml.v3"
+
+	"github.com/elastic/package-spec/v3/code/go/pkg/specerrors"
+)
+
+func TestDeprecatedInvalidPackages(t *testing.T) {
+	for _, fixture := range []string{
+		"bad_deprecation_description",
+		"bad_deprecation_since",
+		"bad_deprecated_integration_policy_input",
+	} {
+		t.Run(fixture, func(t *testing.T) {
+			packagePath := filepath.Join("..", "..", "..", "..", "test", "packages", fixture)
+			require.Error(t, ValidateFromPath(packagePath))
+		})
+	}
+}
+
+func TestDeprecatedReplacedByCorrespondingType(t *testing.T) {
+	tests := []struct {
+		name         string
+		fixture      string
+		manifestPath string
+		objectPath   []any
+		expectedKey  string
+		wrongKey     string
+	}{
+		{
+			name:        "package",
+			fixture:     "deprecated_integration",
+			expectedKey: "package",
+			wrongKey:    "input",
+		},
+		{
+			name:        "policy_template",
+			fixture:     "deprecated_integration_policy",
+			objectPath:  []any{"policy_templates", 0},
+			expectedKey: "policy_template",
+			wrongKey:    "input",
+		},
+		{
+			name:        "input",
+			fixture:     "deprecated_integration_policy_input",
+			objectPath:  []any{"policy_templates", 0, "inputs", 0},
+			expectedKey: "input",
+			wrongKey:    "policy_template",
+		},
+		{
+			name:         "data_stream",
+			fixture:      "deprecated_integration_stream_var",
+			manifestPath: filepath.Join("data_stream", "new_data_stream", "manifest.yml"),
+			expectedKey:  "data_stream",
+			wrongKey:     "variable",
+		},
+		{
+			name:         "variable",
+			fixture:      "deprecated_integration_stream_var",
+			manifestPath: filepath.Join("data_stream", "new_data_stream", "manifest.yml"),
+			objectPath:   []any{"streams", 0, "vars", 0},
+			expectedKey:  "variable",
+			wrongKey:     "data_stream",
+		},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			for _, replacement := range []struct {
+				name  string
+				key   string
+				valid bool
+			}{
+				{name: "corresponding", key: test.expectedKey, valid: true},
+				{name: "different_type", key: test.wrongKey, valid: false},
+			} {
+				t.Run(replacement.name, func(t *testing.T) {
+					packagePath := copyDeprecatedFixture(t, test.fixture)
+					manifestPath := test.manifestPath
+					if manifestPath == "" {
+						manifestPath = "manifest.yml"
+					}
+					setDeprecatedReplacement(t, filepath.Join(packagePath, manifestPath), test.objectPath, replacement.key)
+
+					err := validateDeprecatedFixture(t, packagePath)
+					if replacement.valid {
+						require.NoError(t, err)
+					} else {
+						require.Error(t, err)
+					}
+				})
+			}
+		})
+	}
+}
+
+func validateDeprecatedFixture(t *testing.T, packagePath string) error {
+	t.Helper()
+
+	errs := ValidateFromPath(packagePath)
+	validationErrors, ok := errs.(specerrors.ValidationErrors)
+	if !ok {
+		return errs
+	}
+
+	filterConfig, err := specerrors.LoadConfigFilter(os.DirFS(packagePath))
+	if errors.Is(err, os.ErrNotExist) {
+		return errs
+	}
+	require.NoError(t, err)
+
+	result, err := specerrors.NewFilter(filterConfig).Run(validationErrors)
+	require.NoError(t, err)
+	require.Empty(t, result.UnusedProcessors)
+	return result.Processed
+}
+
+func copyDeprecatedFixture(t *testing.T, fixture string) string {
+	t.Helper()
+	source := filepath.Join("..", "..", "..", "..", "test", "packages", fixture)
+	destination := t.TempDir()
+	require.NoError(t, cp.Copy(source, destination))
+	return destination
+}
+
+func setDeprecatedReplacement(t *testing.T, manifestPath string, objectPath []any, key string) {
+	t.Helper()
+
+	contents, err := os.ReadFile(manifestPath)
+	require.NoError(t, err)
+
+	var manifest map[string]any
+	require.NoError(t, yaml.Unmarshal(contents, &manifest))
+
+	var current any = manifest
+	for _, segment := range objectPath {
+		switch segment := segment.(type) {
+		case string:
+			object, ok := current.(map[string]any)
+			require.True(t, ok)
+			current, ok = object[segment]
+			require.True(t, ok)
+		case int:
+			items, ok := current.([]any)
+			require.True(t, ok)
+			require.Less(t, segment, len(items))
+			current = items[segment]
+		default:
+			t.Fatalf("unsupported path segment %T", segment)
+		}
+	}
+
+	object, ok := current.(map[string]any)
+	require.True(t, ok)
+	deprecated, ok := object["deprecated"].(map[string]any)
+	if !ok {
+		deprecated = map[string]any{
+			"since":       "1.0.0",
+			"description": "This feature is deprecated.",
+		}
+		object["deprecated"] = deprecated
+	}
+	deprecated["replaced_by"] = map[string]any{key: "replacement"}
+
+	contents, err = yaml.Marshal(manifest)
+	require.NoError(t, err)
+	require.NoError(t, os.WriteFile(manifestPath, contents, 0o644))
+}
