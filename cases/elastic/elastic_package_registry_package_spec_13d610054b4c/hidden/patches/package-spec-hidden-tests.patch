+format_version: 3.6.0
+name: deprecated_integration
+title: "Deprecated Integration"
+version: 0.0.1
+source:
+  license: "Elastic-2.0"
+description: "This is a new package."
+type: integration
+categories:
+  - custom
+conditions:
+  kibana:
+    version: "^9.2.3"
+  agent:
+    version: "^8.9.0"
