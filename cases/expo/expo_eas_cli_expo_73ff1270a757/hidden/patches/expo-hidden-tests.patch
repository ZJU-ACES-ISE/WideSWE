+type BrowserCallbackResult = {
+  browserUrl: URL;
+  statusCode: number | undefined;
+  location: string | undefined;
+};
+
+function mockBrowserCallback(sessionSecret?: string): Promise<BrowserCallbackResult> {
+  return new Promise<BrowserCallbackResult>((resolve, reject) => {
+    jest.mocked(openBrowserAsync).mockImplementation(async rawUrl => {
+      const browserUrl = new URL(rawUrl);
+      const callbackUrlValue = browserUrl.searchParams.get('app_redirect_uri');
+      if (!callbackUrlValue) {
+        reject(new Error('Browser login URL is missing app_redirect_uri'));
+        return;
+      }
+
+      const callbackUrl = new URL(callbackUrlValue);
+      if (sessionSecret) {
+        callbackUrl.searchParams.set('session_secret', sessionSecret);
+      }
+
+      const request = http.get(callbackUrl, response => {
+        response.resume();
+        response.on('end', () => {
+          resolve({
+            browserUrl,
+            statusCode: response.statusCode,
+            location: response.headers.location,
+          });
+        });
+      });
+      request.on('error', reject);
+      return false;
+    });
+  });
+}
+
 beforeEach(() => {
