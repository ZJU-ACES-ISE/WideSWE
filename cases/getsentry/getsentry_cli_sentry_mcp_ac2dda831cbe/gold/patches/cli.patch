+  }
+
+  return {
+    label: command || fallbackLabel,
+    metadata: compactStrings([
+      exitCode ? `exit:${exitCode}` : undefined,
+      errorType,
+    ]),
+  };
+}
+
+function formatObjectStoreSpanDisplay(
+  attrs: AttributeSource,
