+import { describe, expect, test } from "vitest";
+import { formatTransactionItem } from "../../../src/lib/formatters/local.js";
+import { stripAnsi } from "../../../src/lib/formatters/plain-detect.js";
+
+const header = { sdk: { name: "sentry.node" } };
+
+function render(data: Record<string, unknown>, transaction = "fallback name") {
+  return stripAnsi(
+    formatTransactionItem(
+      {
+        timestamp: 1_700_000_001,
+        start_timestamp: 1_700_000_000,
+        transaction,
+        contexts: { trace: { op: "custom.transport", data } },
+      },
+      header
+    )
+  );
+}
+
+describe("OpenTelemetry semantic transaction rendering", () => {
+  test.each([
+    [
+      "GenAI",
+      {
+        "gen_ai.operation.name": "chat",
+        "gen_ai.provider.name": "anthropic",
+        "gen_ai.request.model": "claude-sonnet",
+      },
+      ["chat", "anthropic", "claude-sonnet"],
+    ],
+    [
+      "MCP",
+      {
+        "mcp.method.name": "tools/call",
+        "gen_ai.tool.name": "search_files",
+      },
+      ["tools/call", "search_files"],
+    ],
+    [
+      "HTTP",
+      {
+        "http.request.method": "POST",
+        "server.address": "api.example.com",
+        "http.response.status_code": 200,
+      },
+      ["POST", "api.example.com", "200"],
+    ],
+    [
+      "database",
+      {
+        "db.system.name": "postgresql",
+        "db.query.summary": "SELECT users",
+      },
+      ["SELECT users", "postgresql"],
+    ],
+    [
+      "GraphQL",
+      {
+        "graphql.operation.type": "query",
+        "graphql.operation.name": "TraceDetails",
+      },
+      ["query", "TraceDetails"],
+    ],
+    [
+      "RPC",
+      {
+        "rpc.system.name": "grpc",
+        "rpc.service": "TraceService",
+        "rpc.method": "FetchTrace",
+      },
+      ["TraceService", "FetchTrace", "grpc"],
+    ],
+    [
+      "messaging",
+      {
+        "messaging.system": "kafka",
+        "messaging.operation.type": "publish",
+        "messaging.destination.name": "trace-events",
+      },
+      ["publish", "trace-events", "kafka"],
+    ],
+    [
+      "FaaS",
+      {
+        "faas.trigger": "timer",
+        "faas.invoked_name": "trace-worker",
+        "faas.invoked_provider": "aws",
+        "faas.coldstart": true,
+      },
+      ["timer", "trace-worker", "aws", "coldstart"],
+    ],
+    [
+      "object store",
+      {
+        "aws.s3.bucket": "trace-artifacts",
+        "aws.s3.key": "runs/abc.json",
+        "rpc.method": "PutObject",
+      },
+      ["PutObject", "trace-artifacts", "runs/abc.json"],
+    ],
+    [
+      "CloudEvents",
+      {
+        "cloudevents.event_spec_version": "1.0",
+        "cloudevents.event_subject": "trace/e4d1",
+        "cloudevents.event_type": "com.sentry.trace.created",
+      },
+      ["com.sentry.trace.created", "trace/e4d1", "1.0"],
+    ],
+    [
+      "CICD",
+      {
+        "cicd.pipeline.action.name": "BUILD",
+        "cicd.pipeline.name": "mcp-core",
+        "cicd.pipeline.result": "success",
+      },
+      ["BUILD", "mcp-core", "success"],
+    ],
+    [
+      "feature flag",
+      {
+        "feature_flag.key": "semantic-rendering",
+        "feature_flag.provider.name": "flagsmith",
+        "feature_flag.result.variant": "on",
+      },
+      ["semantic-rendering", "on", "flagsmith"],
+    ],
+    [
+      "process",
+      { "process.command": "git", "process.exit.code": 0 },
+      ["git", "0"],
+    ],
+    [
+      "exception",
+      { "exception.type": "ValueError" },
+      ["ValueError"],
+      "job failed",
+    ],
+    [
+      "generic error",
+      { "error.type": "timeout" },
+      ["timeout"],
+      "background job",
+    ],
+  ])("renders %s attributes", (_name, data, expected, transaction) => {
+    const output = render(data as Record<string, unknown>, transaction as string | undefined);
+    for (const token of expected as string[]) {
+      expect(output).toContain(token);
+    }
+  });
+
+  test("uses semantic attributes before HTTP transport attributes", () => {
+    const output = render({
+      "mcp.method.name": "tools/call",
+      "gen_ai.tool.name": "search_files",
+      "http.request.method": "POST",
+      "url.path": "/mcp",
+    });
+    expect(output).toContain("tools/call");
+    expect(output).toContain("search_files");
+    expect(output).not.toContain("POST /mcp");
+  });
+
+  test("falls back to the existing transaction rendering", () => {
+    const output = render({}, "GET /api/users");
+    expect(output).toContain("GET /api/users");
+    expect(output).toContain("custom.transport");
+  });
+});
