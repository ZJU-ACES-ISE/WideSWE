diff --git a/test/commands/local/behavior.test.ts b/test/commands/local/behavior.test.ts
new file mode 100644
index 0000000..86e2936
--- /dev/null
+++ b/test/commands/local/behavior.test.ts
@@ -0,0 +1,241 @@
+import { createServer } from "node:http";
+import { afterEach, describe, expect, test, vi } from "vitest";
+import { serverCommand } from "../../../src/commands/local/server.js";
+import { logger } from "../../../src/lib/logger.js";
+
+const mockedFetch = globalThis.fetch;
+const realFetch = (globalThis as { __originalFetch?: typeof fetch })
+  .__originalFetch;
+
+type LocalFlags = {
+  port: number;
+  host: string;
+  quiet: boolean;
+  filter: string[];
+  format: string;
+};
+
+type ServerFunc = (
+  this: ReturnType<typeof makeContext>,
+  flags: LocalFlags
+) => Promise<void>;
+
+function makeContext(onWrite: (value: string) => void = () => undefined) {
+  return {
+    cwd: process.cwd(),
+    stdout: {
+      write: vi.fn((value: string) => {
+        onWrite(String(value));
+        return true;
+      }),
+    },
+    stderr: { write: vi.fn(() => true) },
+  };
+}
+
+async function waitFor(
+  predicate: () => boolean | Promise<boolean>,
+  timeoutMs = 10_000
+) {
+  const deadline = Date.now() + timeoutMs;
+  while (Date.now() < deadline) {
+    if (await predicate()) {
+      return;
+    }
+    await new Promise((resolveWait) => setTimeout(resolveWait, 50));
+  }
+  throw new Error("Timed out waiting for local CLI behavior");
+}
+
+async function availablePort(): Promise<number> {
+  const server = createServer();
+  await new Promise<void>((resolveListen) =>
+    server.listen(0, "127.0.0.1", resolveListen)
+  );
+  const address = server.address();
+  const port = typeof address === "object" && address ? address.port : 0;
+  await new Promise<void>((resolveClose) => server.close(() => resolveClose()));
+  return port;
+}
+
+function stopRegisteredCommand(previousListeners: Set<(...args: never[]) => void>) {
+  const stop = process
+    .listeners("SIGINT")
+    .find((listener) => !previousListeners.has(listener));
+  stop?.();
+}
+
+afterEach(() => {
+  globalThis.fetch = mockedFetch;
+  vi.restoreAllMocks();
+});
+
+describe.sequential("sentry local public behavior", () => {
+  test("emits filtered AI transactions as NDJSON", async () => {
+    if (!realFetch) {
+      throw new Error("Original fetch implementation is unavailable");
+    }
+    globalThis.fetch = realFetch;
+    const outputParts: string[] = [];
+    const infoLines: string[] = [];
+    vi.spyOn(logger, "log").mockImplementation((message) => {
+      outputParts.push(String(message));
+    });
+    vi.spyOn(logger, "info").mockImplementation((message) => {
+      infoLines.push(String(message));
+    });
+
+    const port = await availablePort();
+    const beforeSignals = new Set(process.listeners("SIGINT"));
+    const func = (await serverCommand.loader()) as unknown as ServerFunc;
+    const running = func.call(makeContext((value) => outputParts.push(value)), {
+      host: "127.0.0.1",
+      port,
+      quiet: false,
+      format: "json",
+      filter: ["ai"],
+    });
+
+    try {
+      await waitFor(async () => {
+        try {
+          return (await realFetch(`http://127.0.0.1:${port}/health`)).ok;
+        } catch {
+          return false;
+        }
+      });
+
+      const header = JSON.stringify({
+        event_id: "0123456789abcdef0123456789abcdef",
+        sdk: { name: "sentry.node" },
+      });
+      const transaction = JSON.stringify({
+        type: "transaction",
+        transaction: "fallback name",
+        start_timestamp: 1_700_000_000,
+        timestamp: 1_700_000_001,
+        contexts: {
+          trace: {
+            op: "ai.pipeline",
+            data: {
+              "gen_ai.operation.name": "chat",
+              "gen_ai.provider.name": "anthropic",
+              "gen_ai.request.model": "claude-sonnet",
+            },
+          },
+        },
+      });
+      const error = JSON.stringify({
+        type: "event",
+        timestamp: 1_700_000_002,
+        message: "must be filtered out",
+      });
+
+      for (const [itemType, payload] of [
+        ["transaction", transaction],
+        ["event", error],
+      ]) {
+        const response = await realFetch(`http://127.0.0.1:${port}/stream`, {
+          method: "POST",
+          headers: { "Content-Type": "application/x-sentry-envelope" },
+          body: `${header}\n${JSON.stringify({ type: itemType })}\n${payload}`,
+        });
+        expect(response.status).toBe(204);
+      }
+
+      const outputLines = () =>
+        outputParts.flatMap((part) => part.split("\n"));
+      await waitFor(
+        () => outputLines().some((line) => line.startsWith("{")),
+        3000
+      );
+      const records = outputLines()
+        .filter((line) => line.startsWith("{"))
+        .map((line) => JSON.parse(line) as Record<string, unknown>);
+      expect(records).toHaveLength(1);
+      const semanticRecord = JSON.stringify(records[0]);
+      expect(semanticRecord).toContain("server");
+      expect(semanticRecord).toContain("chat");
+      expect(semanticRecord).toContain("anthropic");
+      expect(semanticRecord).toContain("claude-sonnet");
+      const banner = infoLines.join("\n");
+      expect(banner).toContain(`http://127.0.0.1:${port}/stream`);
+      expect(banner).toContain("SSE");
+      expect(banner).toContain("SENTRY_SPOTLIGHT");
+    } finally {
+      stopRegisteredCommand(beforeSignals);
+      await running;
+    }
+  });
+
+  test("reconnects SSE with Last-Event-ID after a transient HTTP error", async () => {
+    if (!realFetch) {
+      throw new Error("Original fetch implementation is unavailable");
+    }
+    globalThis.fetch = realFetch;
+    let streamRequests = 0;
+    const lastEventIds: Array<string | undefined> = [];
+    const envelope = JSON.stringify([
+      { sdk: { name: "sentry.node" } },
+      [[{ type: "transaction" }, { transaction: "trace" }]],
+    ]);
+    const mockServer = createServer((request, response) => {
+      if (request.url === "/health") {
+        response.writeHead(200).end("OK");
+        return;
+      }
+      if (request.url !== "/stream") {
+        response.writeHead(404).end();
+        return;
+      }
+
+      streamRequests += 1;
+      lastEventIds.push(
+        typeof request.headers["last-event-id"] === "string"
+          ? request.headers["last-event-id"]
+          : undefined
+      );
+      if (streamRequests === 1) {
+        response.writeHead(200, { "Content-Type": "text/event-stream" });
+        response.end(
+          `id: event-42\nevent: application/x-sentry-envelope\ndata: ${envelope}\n\n`
+        );
+      } else if (streamRequests === 2) {
+        response.writeHead(503).end("retry later");
+      } else {
+        response.writeHead(200, { "Content-Type": "text/event-stream" });
+        response.write(": connected\n\n");
+      }
+    });
+    await new Promise<void>((resolveListen) =>
+      mockServer.listen(0, "127.0.0.1", resolveListen)
+    );
+    const address = mockServer.address();
+    const port = typeof address === "object" && address ? address.port : 0;
+    const beforeSignals = new Set(process.listeners("SIGINT"));
+    const func = (await serverCommand.loader()) as unknown as ServerFunc;
+    const running = func.call(makeContext(), {
+      host: "127.0.0.1",
+      port,
+      quiet: false,
+      format: "human",
+      filter: [],
+    });
+
+    try {
+      await Promise.race([
+        waitFor(() => streamRequests >= 3, 10_000),
+        running.then(() => {
+          throw new Error("SSE consumer exited before reconnecting");
+        }),
+      ]);
+      expect(lastEventIds).toEqual([undefined, "event-42", "event-42"]);
+    } finally {
+      stopRegisteredCommand(beforeSignals);
+      await running;
+      await new Promise<void>((resolveClose) =>
+        mockServer.close(() => resolveClose())
+      );
+    }
+  }, 12_000);
+});
