+}
+
+function expectSemanticSpanLine(
+  output: string,
+  spanId: string,
+  expectedTokens: string[],
+  excludedTokens: string[] = [],
+) {
+  const line = output.split("\n").find((candidate) => candidate.includes(spanId));
+  expect(line, `missing output line for span ${spanId}`).toBeDefined();
+  const normalized = line?.toLowerCase() ?? "";
+  for (const token of expectedTokens) {
+    expect(normalized).toContain(token.toLowerCase());
+  }
+  for (const token of excludedTokens) {
+    expect(normalized).not.toContain(token.toLowerCase());
+  }
+}
