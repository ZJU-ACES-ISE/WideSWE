@@ -0,0 +1,59 @@
+package http
+
+import (
+	"bytes"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync/atomic"
+	"testing"
+
+	"github.com/getsentry/sentry-go/internal/debuglog"
+	"github.com/getsentry/sentry-go/internal/protocol"
+	"github.com/getsentry/sentry-go/internal/testutils"
+)
+
+func TestEcoSyncRequestEntityTooLargeResponse(t *testing.T) {
+	var requestCount int64
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		atomic.AddInt64(&requestCount, 1)
+		w.WriteHeader(http.StatusRequestEntityTooLarge)
+		_, _ = w.Write([]byte("relay response details"))
+	}))
+	defer server.Close()
+
+	var logBuffer bytes.Buffer
+	debuglog.SetOutput(&logBuffer)
+	defer debuglog.SetOutput(io.Discard)
+
+	transport, ok := NewAsyncTransport(TransportOptions{
+		Dsn: "http://key@" + server.URL[7:] + "/123",
+	}).(*AsyncTransport)
+	if !ok {
+		t.Fatal("expected AsyncTransport")
+	}
+	defer transport.Close()
+
+	if err := transport.SendEnvelope(testEnvelope(protocol.EnvelopeItemTypeEvent)); err != nil {
+		t.Fatalf("failed to send envelope: %v", err)
+	}
+	if !transport.Flush(testutils.FlushTimeout()) {
+		t.Fatal("Flush timed out")
+	}
+	if got := atomic.LoadInt64(&requestCount); got != 1 {
+		t.Fatalf("request count = %d, want 1", got)
+	}
+
+	output := logBuffer.String()
+	lowerOutput := strings.ToLower(output)
+	hasSizeReason := strings.Contains(lowerOutput, "too large") ||
+		(strings.Contains(lowerOutput, "size") &&
+			(strings.Contains(lowerOutput, "limit") || strings.Contains(lowerOutput, "exceed")))
+	if !hasSizeReason {
+		t.Fatalf("missing HTTP 413 size-rejection message in %q", output)
+	}
+	if !strings.Contains(output, "relay response details") {
+		t.Fatalf("missing response body in %q", output)
+	}
+}
