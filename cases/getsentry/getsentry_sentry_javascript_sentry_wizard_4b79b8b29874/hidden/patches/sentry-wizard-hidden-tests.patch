+++ b/test/react-router/react-router-wizard-on-error.test.ts
@@ -0,0 +1,126 @@
+import * as fs from 'fs';
+import * as os from 'os';
+import * as path from 'path';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+
+const mocks = vi.hoisted(() => ({
+  getPackageDotJson: vi.fn(),
+}));
+
+vi.mock('@clack/prompts', () => ({
+  default: {
+    log: { info: vi.fn(), warn: vi.fn(), error: vi.fn(), success: vi.fn() },
+    outro: vi.fn(),
+  },
+}));
+
+vi.mock('@sentry/node', () => ({ setTag: vi.fn() }));
+
+vi.mock('../../src/telemetry', () => ({
+  withTelemetry: vi.fn((_options, callback: () => unknown) => callback()),
+  traceStep: vi.fn(async (_name, callback: () => unknown) => callback()),
+}));
+
+vi.mock('../../src/utils/clack', () => ({
+  askShouldCreateExamplePage: vi.fn(async () => false),
+  confirmContinueIfNoOrDirtyGitRepo: vi.fn(async () => undefined),
+  featureSelectionPrompt: vi.fn(async () => ({
+    performance: false,
+    replay: false,
+    logs: false,
+    profiling: false,
+  })),
+  getOrAskForProjectData: vi.fn(async () => ({
+    selectedProject: {
+      id: '1',
+      slug: 'project',
+      organization: { slug: 'organization' },
+      keys: [{ dsn: { public: 'https://public@example.com/1' } }],
+    },
+    authToken: 'token',
+    selfHosted: false,
+    sentryUrl: 'https://example.com',
+  })),
+  getPackageDotJson: mocks.getPackageDotJson,
+  isUsingTypeScript: vi.fn(() => false),
+  printWelcome: vi.fn(),
+  installPackage: vi.fn(async () => undefined),
+  addDotEnvSentryBuildPluginFile: vi.fn(async () => undefined),
+  showCopyPasteInstructions: vi.fn(async () => undefined),
+  makeCodeSnippet: vi.fn((_colors, callback) => callback(String, String, String)),
+  runPrettierIfInstalled: vi.fn(async () => undefined),
+}));
+
+vi.mock('../../src/utils/clack/mcp-config', () => ({
+  offerProjectScopedMcpConfig: vi.fn(async () => undefined),
+}));
+
+vi.mock('../../src/react-router/sdk-example', () => ({
+  createExamplePage: vi.fn(async () => undefined),
+}));
+
+vi.mock('../../src/utils/abort-if-sportlight-not-supported', () => ({
+  abortIfSpotlightNotSupported: vi.fn(),
+}));
+
+vi.mock('../../src/react-router/sdk-setup', async importActual => {
+  const actual = await importActual<typeof import('../../src/react-router/sdk-setup')>();
+  return {
+    ...actual,
+    runReactRouterReveal: vi.fn(),
+    instrumentRootRoute: vi.fn(async () => undefined),
+    instrumentSentryOnEntryServer: vi.fn(async () => undefined),
+    createServerInstrumentationFile: vi.fn(),
+    updatePackageJsonScripts: vi.fn(async () => undefined),
+    configureReactRouterVitePlugin: vi.fn(async () => undefined),
+    configureReactRouterConfig: vi.fn(async () => undefined),
+  };
+});
+
+import { runReactRouterWizard } from '../../src/react-router/react-router-wizard';
+
+const originalCwd = process.cwd();
+let projectDir: string;
+
+async function runForVersion(version?: string): Promise<string> {
+  mocks.getPackageDotJson.mockResolvedValue(
+    version ? { dependencies: { '@react-router/dev': version } } : {},
+  );
+
+  await runReactRouterWizard({
+    telemetryEnabled: false,
+    ignoreGitChanges: true,
+  } as never);
+
+  return fs.readFileSync(path.join(projectDir, 'app', 'entry.client.jsx'), 'utf8');
+}
+
+describe('React Router onError version support', () => {
+  beforeEach(() => {
+    projectDir = fs.mkdtempSync(path.join(os.tmpdir(), 'sentry-wizard-on-error-'));
+    fs.mkdirSync(path.join(projectDir, 'app'));
+    fs.writeFileSync(
+      path.join(projectDir, 'app', 'entry.client.jsx'),
+      `import { HydratedRouter } from 'react-router/dom';\n<HydratedRouter />;\n`,
+    );
+    process.chdir(projectDir);
+  });
+
+  afterEach(() => {
+    process.chdir(originalCwd);
+    fs.rmSync(projectDir, { recursive: true, force: true });
+    vi.clearAllMocks();
+  });
+
+  it('installs sentryOnError for @react-router/dev 7.11.0 and newer', async () => {
+    expect(await runForVersion('7.11.0')).toContain('onError={Sentry.sentryOnError}');
+  });
+
+  it('does not install sentryOnError for older @react-router/dev versions', async () => {
+    expect(await runForVersion('7.10.0')).not.toContain('onError={Sentry.sentryOnError}');
+  });
+
+  it('does not install sentryOnError when @react-router/dev is absent', async () => {
+    expect(await runForVersion()).not.toContain('onError={Sentry.sentryOnError}');
+  });
+});
