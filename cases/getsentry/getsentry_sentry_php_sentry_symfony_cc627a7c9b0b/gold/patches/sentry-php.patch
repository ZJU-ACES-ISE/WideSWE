+          echo "${RUNNER_TEMP}/bin" >> "${GITHUB_PATH}"
+          "${RUNNER_TEMP}/bin/rr" --version
+        shell: bash
+
+      - name: Run PHPUnit tests (excluding PHPT)
+        run: vendor/bin/phpunit tests --test-suffix Test.php --verbose
+
