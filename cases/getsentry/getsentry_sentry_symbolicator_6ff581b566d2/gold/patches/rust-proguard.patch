+    5:5:void method():30 -> run
+";
+        let mapping = ProguardMapping::new(mapping.as_bytes());
+        let mut buf = Vec::new();
+        ProguardCache::write(&mapping, &mut buf).unwrap();
+        let cache = ProguardCache::parse(&buf).unwrap();
