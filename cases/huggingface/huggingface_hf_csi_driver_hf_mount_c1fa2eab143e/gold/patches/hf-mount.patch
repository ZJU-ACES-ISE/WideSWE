+    #[test]
+    fn test_insert_below_trigger_does_not_evict() {
+        // cap=100, trigger = 100 + EVICT_TRIGGER_OVERAGE. Below that, no evict.
+        let mut table = mk_table_with_soft_limit(100);
+        for i in 0..150 {
