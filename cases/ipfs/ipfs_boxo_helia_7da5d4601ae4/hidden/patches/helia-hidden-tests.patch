+function receiveWant (network: Network, from: PeerId, entries: WantlistEntry[], full: boolean = false): void {
+  network.safeDispatchEvent('bitswap:message', {
+    detail: {
+      peer: from,
+      message: {
+        full,
+        blocks: [],
+        blockPresences: [],
+        pendingBytes: 0,
+        wantlist: {
+          full,
+          entries
+        }
+      }
+    }
+  })
+}
+
+const defaultMaxWantListSize = 1024
+const wantListRetryOptions = { retries: 20, minTimeout: 10, maxTimeout: 100 }
+
+async function createBlocks (count: number): Promise<{ blocks: Uint8Array[], cids: CID[] }> {
+  const blocks: Uint8Array[] = []
+  const cids: CID[] = []
+
+  for (let i = 0; i < count; i++) {
+    const block = Uint8Array.from([
+      i >>> 24,
+      i >>> 16,
+      i >>> 8,
+      i,
+      0x62,
+      0x69,
+      0x74,
+      0x73
+    ])
+    blocks.push(block)
+    cids.push(CID.createV1(0x55, await sha256.digest(block)))
+  }
+
+  return { blocks, cids }
+}
+
