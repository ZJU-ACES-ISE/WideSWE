+func mustMultiaddrs(t *testing.T, strs []string) []ma.Multiaddr {
+	t.Helper()
+	addrs := make([]ma.Multiaddr, 0, len(strs))
+	for _, str := range strs {
+		addr, err := ma.NewMultiaddr(str)
+		require.NoError(t, err)
+		addrs = append(addrs, addr)
+	}
+	return addrs
+}
