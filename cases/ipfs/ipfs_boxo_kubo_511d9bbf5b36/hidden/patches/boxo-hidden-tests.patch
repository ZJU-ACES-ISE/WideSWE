+func TestGatewayIdentityCIDSizeLimit(t *testing.T) {
+	ts, _, _ := newTestServerAndNode(t, "fixtures.car")
+
+	newIdentityCID := func(data []byte) cid.Cid {
+		hash, err := mh.Sum(data, mh.IDENTITY, -1)
+		require.NoError(t, err)
+		return cid.NewCidV1(cid.Raw, hash)
+	}
+
+	t.Run("digest at maximum is served", func(t *testing.T) {
+		data := bytes.Repeat([]byte("a"), verifcid.DefaultMaxIdentityDigestSize)
+		resp := mustDo(t, mustNewRequest(t, http.MethodGet, ts.URL+"/ipfs/"+newIdentityCID(data).String(), nil))
+		defer resp.Body.Close()
+		body, err := io.ReadAll(resp.Body)
+		require.NoError(t, err)
+		require.Equal(t, http.StatusOK, resp.StatusCode)
+		require.Equal(t, data, body)
+	})
+
+	t.Run("digest below normal minimum is served", func(t *testing.T) {
+		data := []byte("hello")
+		resp := mustDo(t, mustNewRequest(t, http.MethodGet, ts.URL+"/ipfs/"+newIdentityCID(data).String(), nil))
+		defer resp.Body.Close()
+		body, err := io.ReadAll(resp.Body)
+		require.NoError(t, err)
+		require.Equal(t, http.StatusOK, resp.StatusCode)
+		require.Equal(t, data, body)
+	})
+
+	t.Run("digest above maximum is rejected with sizes", func(t *testing.T) {
+		data := bytes.Repeat([]byte("b"), verifcid.DefaultMaxIdentityDigestSize+1)
+		resp := mustDo(t, mustNewRequest(t, http.MethodGet, ts.URL+"/ipfs/"+newIdentityCID(data).String(), nil))
+		defer resp.Body.Close()
+		body, err := io.ReadAll(resp.Body)
+		require.NoError(t, err)
+		require.Equal(t, http.StatusInternalServerError, resp.StatusCode)
+		require.Contains(t, string(body), "digest too large")
+		require.Contains(t, string(body), fmt.Sprint(len(data)))
+		require.Contains(t, string(body), fmt.Sprint(verifcid.DefaultMaxIdentityDigestSize))
+	})
+}
