+def _contains_mapping(value: object, expected: Mapping[str, str], seen: set[int] | None = None) -> bool:
+    seen = seen or set()
+    if id(value) in seen:
+        return False
+    seen.add(id(value))
+
+    if isinstance(value, Mapping):
+        if all(value.get(key) == expected_value for key, expected_value in expected.items()):
+            return True
+        children = value.values()
+    elif is_dataclass(value) and not isinstance(value, type):
+        children = (getattr(value, field.name) for field in fields(value))
+    elif hasattr(value, "model_dump"):
+        children = (value.model_dump(),)
+    elif isinstance(value, (list, tuple, set)):
+        children = value
+    else:
+        return False
+    return any(_contains_mapping(child, expected, seen) for child in children)
+
