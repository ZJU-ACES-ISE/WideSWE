+test('loads a Composer package guideline and keeps its logical key', function (): void {
+    $root = sys_get_temp_dir().'/boost_composer_guideline_'.uniqid();
+    $guidelineDir = $root.'/vendor/pestphp/pest/resources/boost/guidelines';
+    File::ensureDirectoryExists($guidelineDir);
+    file_put_contents($guidelineDir.'/core.blade.php', '# Package Pest Guideline');
+
+    try {
+        $roster = boostGuidelineComposerRoster($root, 'pestphp/pest', '3.0.0');
+        $this->app->instance(Roster::class, $roster);
+        $composer = new GuidelineComposer($roster, $this->herd);
+
+        expect($composer->compose())->toContain('Package Pest Guideline')
+            ->and($composer->used())->toContain('pest/core');
+    } finally {
+        File::deleteDirectory($root);
+    }
+});
+
+test('falls back to the built-in guideline when a package provides none', function (): void {
+    $root = sys_get_temp_dir().'/boost_composer_fallback_'.uniqid();
+    File::ensureDirectoryExists($root.'/vendor/pestphp/pest');
+
+    try {
+        $roster = boostGuidelineComposerRoster($root, 'pestphp/pest', '3.0.0');
+        $this->app->instance(Roster::class, $roster);
+        $guidelines = (new GuidelineComposer($roster, $this->herd))->compose();
+
+        expect($guidelines)->toContain('=== pest/core rules ===');
+    } finally {
+        File::deleteDirectory($root);
+    }
+});
+
+test('a user markdown guideline overrides a package guideline', function (): void {
+    $root = sys_get_temp_dir().'/boost_guideline_override_'.uniqid();
+    $guidelineDir = $root.'/vendor/pestphp/pest/resources/boost/guidelines';
+    $overrideDir = $root.'/.ai/guidelines';
+    File::ensureDirectoryExists($guidelineDir);
+    File::ensureDirectoryExists($overrideDir.'/pest');
+    file_put_contents($guidelineDir.'/core.blade.php', '# Package Pest Guideline');
+    file_put_contents($overrideDir.'/pest/core.md', '# User Pest Guideline');
+
+    try {
+        $roster = boostGuidelineComposerRoster($root, 'pestphp/pest', '3.0.0');
+        $this->app->instance(Roster::class, $roster);
+        $composer = Mockery::mock(GuidelineComposer::class, [$roster, $this->herd])->makePartial();
+        $composer->shouldReceive('customGuidelinePath')
+            ->andReturnUsing(fn ($path = ''): string => $overrideDir.'/'.ltrim((string) $path, '/'));
+
+        $pestCore = $composer->guidelines()->get('pest/core');
+        expect($pestCore)->not->toBeNull()
+            ->and($pestCore['content'])->toContain('User Pest Guideline')
+            ->and($pestCore['content'])->not->toContain('Package Pest Guideline');
+    } finally {
+        File::deleteDirectory($root);
+    }
+});
+
