+        ---
+        name: livewire-development
+        description: Package Livewire skill
+        ---
+
+        # Package Livewire Skill
+        MARKDOWN);
+
+    try {
+        $roster = boostSkillComposerRoster($root, 'livewire/livewire');
+        $skill = (new SkillComposer($roster))->skills()->get('livewire-development');
+
+        expect($skill)->not->toBeNull()
+            ->and($skill->description)->toBe('Package Livewire skill')
+            ->and($skill->path)->toStartWith($root);
+    } finally {
+        File::deleteDirectory($root);
+    }
+});
