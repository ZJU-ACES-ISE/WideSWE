 use function Pest\testDirectory;
 
+function boostGuidelineComposerRoster(string $root, string $package, string $version = '1.0.0'): Roster
+{
+    File::ensureDirectoryExists($root);
+    file_put_contents($root.'/composer.json', json_encode([
+        'require' => [$package => '^'.$version],
+    ], JSON_THROW_ON_ERROR));
+    file_put_contents($root.'/composer.lock', json_encode([
+        'packages' => [['name' => $package, 'version' => 'v'.$version]],
+        'packages-dev' => [],
+    ], JSON_THROW_ON_ERROR));
+
+    return Roster::scan($root);
+}
+
+function boostGuidelineNpmRoster(string $root, string $package, string $version = '2.1.0'): Roster
+{
+    File::ensureDirectoryExists($root);
+    $packagePath = 'node_modules/'.$package;
+    file_put_contents($root.'/package.json', json_encode([
+        'dependencies' => [$package => '^'.$version],
+    ], JSON_THROW_ON_ERROR));
+    file_put_contents($root.'/package-lock.json', json_encode([
+        'lockfileVersion' => 3,
+        'packages' => [
+            '' => ['dependencies' => [$package => '^'.$version]],
+            $packagePath => ['version' => $version],
+        ],
+    ], JSON_THROW_ON_ERROR));
+
+    return Roster::scan($root);
+}
+
