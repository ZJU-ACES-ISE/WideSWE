+
+        expect($guidelines)->toContain('Package npm Guideline '.$package);
+    } finally {
+        File::deleteDirectory($root);
+    }
+})->with([
+    '@inertiajs/react',
+    '@laravel/vite-plugin-wayfinder',
+    'laravel-echo',
+]);
