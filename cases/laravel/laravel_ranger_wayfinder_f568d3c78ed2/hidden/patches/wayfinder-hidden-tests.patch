--- /dev/null
+++ b/tests/AppUrlRootResolution.test.ts
@@ -0,0 +1,69 @@
+import { execFileSync } from "node:child_process";
+import { rmSync } from "node:fs";
+import path from "node:path";
+import { expect, test, vi } from "vitest";
+
+const testbench = path.join(__dirname, "../vendor/bin/testbench");
+
+const generateWithAppUrl = (appUrl: string, outputPath: string) => {
+    rmSync(outputPath, { recursive: true, force: true });
+
+    execFileSync(
+        testbench,
+        ["wayfinder:generate", `--path=${outputPath}`, "--with-form"],
+        {
+            env: {
+                ...process.env,
+                APP_URL: appUrl,
+            },
+        },
+    );
+};
+
+test("prefixes generated URLs with APP_URL path", async () => {
+    const outputPath = path.join(
+        __dirname,
+        "../.ecosyncbench/generated/app-url-path",
+    );
+
+    generateWithAppUrl("http://localhost:8081/v2", outputPath);
+
+    const { index, show } = await vi.importActual<
+        typeof import("../workbench/resources/js/actions/App/Http/Controllers/PostController")
+    >(
+        path.join(outputPath, "actions/App/Http/Controllers/PostController.ts"),
+    );
+
+    expect(index.url()).toBe("/v2/posts");
+    expect(show.url({ post: 1 })).toBe("/v2/posts/1");
+});
+
+test("does not inject APP_URL port into explicit domain routes", async () => {
+    const outputPath = path.join(
+        __dirname,
+        "../.ecosyncbench/generated/app-url-port",
+    );
+
+    generateWithAppUrl("https://localhost:8001", outputPath);
+
+    const { defaultParametersDomain, fixedDomain } = await vi.importActual<
+        typeof import("../workbench/resources/js/actions/App/Http/Controllers/DomainController")
+    >(
+        path.join(
+            outputPath,
+            "actions/App/Http/Controllers/DomainController.ts",
+        ),
+    );
+
+    expect(fixedDomain.url({ param: "value" })).toBe(
+        "//example.test/fixed-domain/value",
+    );
+    expect(
+        defaultParametersDomain.url({
+            defaultDomain: "example",
+            param: "value",
+        }),
+    ).toBe(
+        "//example.au/default-parameters-domain/value",
+    );
+});
