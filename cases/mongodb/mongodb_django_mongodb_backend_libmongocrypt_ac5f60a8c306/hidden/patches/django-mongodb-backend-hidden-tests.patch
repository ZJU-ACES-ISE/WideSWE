+class SupportsQueryableEncryptionTests(TestCase):
+    def setUp(self):
+        for name in (
+            "supports_queryable_encryption",
+            "mongodb_version",
+            "is_mongodb_8_0",
+        ):
+            connection.features.__dict__.pop(name, None)
+
+    def tearDown(self):
+        for name in (
+            "supports_queryable_encryption",
+            "mongodb_version",
+            "is_mongodb_8_0",
+        ):
+            connection.features.__dict__.pop(name, None)
+
+    @staticmethod
+    def enterprise_response(command):
+        if command in {"buildInfo", "buildinfo"}:
+            return {"modules": ["enterprise"]}
+        if command == "getCmdLineOpts":
+            return {"parsed": {"enterpriseModule": True}}
+        return {}
+
+    @staticmethod
+    def non_enterprise_response(command):
+        if command in {"buildInfo", "buildinfo"}:
+            return {"modules": []}
+        if command == "getCmdLineOpts":
+            return {"parsed": {}}
+        return {}
+
+    @staticmethod
+    def atlas_response(command):
+        if command in {"buildInfo", "buildinfo"}:
+            return {"modules": [], "atlasVersion": "test"}
+        if command == "getCmdLineOpts":
+            return {"parsed": {}}
+        return {}
+
+    def test_supported_on_atlas(self):
+        """Supported on MongoDB 8.0+ Atlas replica set or sharded cluster."""
+        with (
+            patch(
+                "pymongo.synchronous.database.Database.command", wraps=self.atlas_response
+            ),
+            patch.dict(
+                connection.features.__dict__,
+                {"supports_atlas_search": True, "_supports_transactions": True},
+            ),
+            patch.object(connection, "get_database_version", return_value=(8, 0)),
+        ):
+            self.assertIs(connection.features.supports_queryable_encryption, True)
+
+    def test_supported_on_enterprise(self):
+        """Supported on MongoDB 8.0+ Enterprise replica set or sharded cluster."""
+        with (
+            patch("pymongo.synchronous.database.Database.command", wraps=self.enterprise_response),
+            patch.dict(
+                connection.features.__dict__,
+                {"supports_atlas_search": False, "_supports_transactions": True},
+            ),
+            patch.object(connection, "get_database_version", return_value=(8, 0)),
+        ):
+            self.assertIs(connection.features.supports_queryable_encryption, True)
+
+    def test_atlas_or_enterprise_required(self):
+        """Not supported on MongoDB Community Edition."""
+        with (
+            patch(
+                "pymongo.synchronous.database.Database.command", wraps=self.non_enterprise_response
+            ),
+            patch.dict(
+                connection.features.__dict__,
+                {"supports_atlas_search": False, "_supports_transactions": True},
+            ),
+            patch.object(connection, "get_database_version", return_value=(8, 0)),
+        ):
+            self.assertIs(connection.features.supports_queryable_encryption, False)
+
+    def test_transactions_required(self):
+        """
+        Not supported if database isn't a replica set or sharded cluster
+        (i.e. DatabaseFeatures._supports_transactions = False).
+        """
+        with (
+            patch("pymongo.synchronous.database.Database.command", wraps=self.enterprise_response),
+            patch.dict(
+                connection.features.__dict__,
+                {"supports_atlas_search": False, "_supports_transactions": False},
+            ),
+            patch.object(connection, "get_database_version", return_value=(8, 0)),
+        ):
+            self.assertIs(connection.features.supports_queryable_encryption, False)
+
+    def test_mongodb_8_0_required(self):
+        """Not supported on MongoDB < 8.0"""
+        with (
+            patch("pymongo.synchronous.database.Database.command", wraps=self.enterprise_response),
+            patch.dict(
+                connection.features.__dict__,
+                {"supports_atlas_search": False, "_supports_transactions": True},
+            ),
+            patch.object(connection, "get_database_version", return_value=(7, 0)),
+        ):
+            self.assertIs(connection.features.supports_queryable_encryption, False)
