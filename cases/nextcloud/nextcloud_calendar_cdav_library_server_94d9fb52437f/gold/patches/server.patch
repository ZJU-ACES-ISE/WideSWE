+
+		$calendarsTable = $schema->getTable('calendars');
+
+		if ($calendarsTable->hasColumn('default_alarm')) {
+			$calendarsTable->dropColumn('default_alarm');
+		}
+
+		if (!$calendarsTable->hasColumn('default_alarm_pday')) {
