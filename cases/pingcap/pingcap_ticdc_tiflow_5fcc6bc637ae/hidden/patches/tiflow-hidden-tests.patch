+package kafka
+
+import (
+	"context"
+	"net/url"
+	"testing"
+
+	"github.com/pingcap/tiflow/cdc/model"
+	"github.com/pingcap/tiflow/pkg/config"
+	"github.com/stretchr/testify/require"
+)
+
+func TestKafkaMaxRetryFromSinkURI(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		name     string
+		query    string
+		expected int
+		wantErr  bool
+	}{
+		{name: "default", expected: 5},
+		{name: "positive", query: "&max-retry=7", expected: 7},
+		{name: "zero", query: "&max-retry=0", expected: 0},
+		{name: "negative ignored", query: "&max-retry=-1", expected: 5},
+		{name: "invalid", query: "&max-retry=not-an-integer", wantErr: true},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			t.Parallel()
+
+			sinkURI, err := url.Parse(
+				"kafka://127.0.0.1:9092/topic?kafka-version=2.6.0" + test.query,
+			)
+			require.NoError(t, err)
+
+			options := NewOptions()
+			err = options.Apply(
+				model.DefaultChangeFeedID("test"),
+				sinkURI,
+				config.GetDefaultReplicaConfig(),
+			)
+			if test.wantErr {
+				require.Error(t, err)
+				return
+			}
+			require.NoError(t, err)
+
+			producerConfig, err := NewSaramaConfig(context.Background(), options)
+			require.NoError(t, err)
+			require.Equal(t, test.expected, producerConfig.Producer.Retry.Max)
+		})
+	}
+}
