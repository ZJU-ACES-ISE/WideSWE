+func TestExternalIDCompatibilityDisabledPreservesParameters(t *testing.T) {
+	tests := []struct {
+		name       string
+		sourceDir  string
+		parameters string
+	}{
+		{
+			name:       "s3",
+			sourceDir:  "s3://bucket/path?role-arn=arn&external-id=keep&external_id=keep-too&region=us-east-1",
+			parameters: "role-arn=arn&external-id=keep&external_id=keep-too&region=us-east-1",
+		},
+		{
+			name:       "s3-compatible",
+			sourceDir:  "oss://bucket/path?external-id=keep&external_id=keep-too&region=us-east-1",
+			parameters: "external-id=keep&external_id=keep-too&region=us-east-1",
+		},
+		{
+			name:       "non-s3",
+			sourceDir:  "gcs://bucket/path?external-id=keep&external_id=keep-too&region=us-east-1",
+			parameters: "external-id=keep&external_id=keep-too&region=us-east-1",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			ctrl := gomock.NewController(t)
+			mockSDK := sdkmock.NewMockSDK(ctrl)
+			cfg := config.NewConfig()
+			cfg.Mydumper.SourceDir = tt.sourceDir
+
+			mockSDK.EXPECT().GenerateImportSQL(gomock.Any(), gomock.Any()).DoAndReturn(
+				func(_ *importsdk.TableMeta, opts *importsdk.ImportOptions) (string, error) {
+					require.Equal(t, tt.parameters, opts.ResourceParameters)
+					require.Equal(t, tt.sourceDir, cfg.Mydumper.SourceDir)
+					return "IMPORT INTO ...", nil
+				})
+			mockSDK.EXPECT().SubmitJob(gomock.Any(), "IMPORT INTO ...").Return(int64(123), nil)
+
+			submitter := importinto.NewJobSubmitter(mockSDK, cfg, "group", log.L())
+			job, err := submitter.SubmitTable(context.Background(), &importsdk.TableMeta{
+				Database: "db",
+				Table:    "t",
+			})
+			require.NoError(t, err)
+			require.NotNil(t, job)
+		})
+	}
+}
