+func TestExternalIDCompatibilityCanBeEnabledThroughConfig(t *testing.T) {
+	baseCfg := config.NewConfig()
+	paths := collectFalseBoolPaths(reflect.ValueOf(baseCfg).Elem(), nil)
+	var compatibilityPath []int
+	for _, path := range paths {
+		cfg := config.NewConfig()
+		cfg.Mydumper.SourceDir = "s3://bucket/path?role-arn=arn&external-id=remove&external_id=remove-too&region=us-east-1"
+		field := valueAtPath(reflect.ValueOf(cfg).Elem(), path)
+		if !field.IsValid() || !field.CanSet() || field.Kind() != reflect.Bool {
+			continue
+		}
+		field.SetBool(true)
+
+		parameters := importParametersForConfig(t, cfg)
+		if !containsExternalID(parameters) {
+			compatibilityPath = path
+			break
+		}
+	}
+
+	if compatibilityPath == nil {
+		t.Fatal("no Lightning configuration switch enables S3 external-ID compatibility")
+	}
+
+	checks := []struct {
+		sourceDir       string
+		keepsExternalID bool
+	}{
+		{
+			sourceDir: "s3://bucket/path?role-arn=arn&external-id=remove&external_id=remove-too&region=us-east-1",
+		},
+		{
+			sourceDir: "oss://bucket/path?role-arn=arn&external-id=remove&external_id=remove-too&region=us-east-1",
+		},
+		{
+			sourceDir:       "gcs://bucket/path?external-id=keep&external_id=keep-too&region=us-east-1",
+			keepsExternalID: true,
+		},
+	}
+	for _, check := range checks {
+		cfg := config.NewConfig()
+		cfg.Mydumper.SourceDir = check.sourceDir
+		field := valueAtPath(reflect.ValueOf(cfg).Elem(), compatibilityPath)
+		require.True(t, field.IsValid() && field.CanSet() && field.Kind() == reflect.Bool)
+		field.SetBool(true)
+
+		parameters := importParametersForConfig(t, cfg)
+		require.Equal(t, check.keepsExternalID, containsExternalID(parameters))
+		require.Equal(t, "us-east-1", parameters.Get("region"))
+		require.Equal(t, check.sourceDir, cfg.Mydumper.SourceDir)
+	}
+}
+
+func importParametersForConfig(t *testing.T, cfg *config.Config) url.Values {
+	t.Helper()
+	ctrl := gomock.NewController(t)
+	mockSDK := sdkmock.NewMockSDK(ctrl)
+	var rawParameters string
+	mockSDK.EXPECT().GenerateImportSQL(gomock.Any(), gomock.Any()).DoAndReturn(
+		func(_ *importsdk.TableMeta, opts *importsdk.ImportOptions) (string, error) {
+			rawParameters = opts.ResourceParameters
+			return "IMPORT INTO ...", nil
+		})
+	mockSDK.EXPECT().SubmitJob(gomock.Any(), "IMPORT INTO ...").Return(int64(123), nil)
+
+	submitter := importinto.NewJobSubmitter(mockSDK, cfg, "group", log.L())
+	_, err := submitter.SubmitTable(context.Background(), &importsdk.TableMeta{Database: "db", Table: "t"})
+	require.NoError(t, err)
+	parameters, err := url.ParseQuery(rawParameters)
+	require.NoError(t, err)
+	return parameters
+}
+
+func collectFalseBoolPaths(value reflect.Value, prefix []int) [][]int {
+	valueType := value.Type()
+	var paths [][]int
+	for i := 0; i < value.NumField(); i++ {
+		if valueType.Field(i).PkgPath != "" {
+			continue
+		}
+		field := value.Field(i)
+		path := append(append([]int(nil), prefix...), i)
+		switch field.Kind() {
+		case reflect.Bool:
+			if field.CanSet() && !field.Bool() {
+				paths = append(paths, path)
+			}
+		case reflect.Struct:
+			paths = append(paths, collectFalseBoolPaths(field, path)...)
+		case reflect.Pointer:
+			if !field.IsNil() && field.Elem().Kind() == reflect.Struct {
+				paths = append(paths, collectFalseBoolPaths(field.Elem(), path)...)
+			}
+		}
+	}
+	return paths
+}
+
+func valueAtPath(value reflect.Value, path []int) reflect.Value {
+	for _, index := range path {
+		value = value.Field(index)
+		if value.Kind() == reflect.Pointer {
+			if value.IsNil() {
+				return reflect.Value{}
+			}
+			value = value.Elem()
+		}
+	}
+	return value
+}
+
+func containsExternalID(parameters url.Values) bool {
+	for key := range parameters {
+		normalized := strings.ToLower(strings.ReplaceAll(key, "_", "-"))
+		if normalized == "external-id" {
+			return true
+		}
+	}
+	return false
+}
