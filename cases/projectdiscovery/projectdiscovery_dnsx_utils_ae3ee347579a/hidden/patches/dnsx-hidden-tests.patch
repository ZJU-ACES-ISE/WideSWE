+
+func TestCLIRejectsWildcardFilteringInStreamMode(t *testing.T) {
+	t.Run("auto wildcard", func(t *testing.T) {
+		_, err := runDNSXCLI(t, "--stream", "--auto-wildcard")
+		require.Error(t, err)
+	})
+
+	t.Run("manual wildcard", func(t *testing.T) {
+		_, err := runDNSXCLI(t, "--stream", "--wildcard-domain", "example.com")
+		require.Error(t, err)
+	})
+}
+
+func TestNewRejectsInvalidWildcardDomain(t *testing.T) {
+	for _, input := range []string{"*.", "foo bar", "example..com", "sub.*.example.com", "foo*bar.com"} {
+		t.Run(input, func(t *testing.T) {
+			runner, err := New(&Options{WildcardDomain: input})
+			require.Nil(t, runner)
+			require.Error(t, err)
+		})
+	}
+}
