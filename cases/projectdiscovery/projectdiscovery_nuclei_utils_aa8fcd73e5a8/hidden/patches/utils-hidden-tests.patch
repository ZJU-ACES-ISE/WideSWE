diff --git a/url/path_contract_generator.go b/url/path_contract_generator.go
new file mode 100644
index 0000000..33f29f6
--- /dev/null
+++ b/url/path_contract_generator.go
@@ -0,0 +1,109 @@
+//go:build ignore
+
+package main
+
+import (
+	"bytes"
+	"fmt"
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+)
+
+type function struct {
+	name       string
+	resultKind int
+}
+
+func main() {
+	if len(os.Args) != 3 {
+		panic("usage: path_contract_generator <package-dir> <output-file>")
+	}
+
+	functions, err := findCandidates(os.Args[1])
+	if err != nil {
+		panic(err)
+	}
+
+	var output bytes.Buffer
+	output.WriteString("// Code generated by the hidden-test runner. DO NOT EDIT.\n")
+	output.WriteString("package urlutil\n\n")
+	output.WriteString("func init() {\n")
+	for _, fn := range functions {
+		if fn.resultKind == 1 {
+			fmt.Fprintf(&output, "\tpathEncodingCandidates = append(pathEncodingCandidates, pathEncodingCandidate{%q, %s})\n", fn.name, fn.name)
+			fmt.Fprintf(&output, "\tpathDecodingCandidates = append(pathDecodingCandidates, pathDecodingCandidate{%q, func(value string) (string, error) { return %s(value), nil }})\n", fn.name, fn.name)
+		} else {
+			fmt.Fprintf(&output, "\tpathDecodingCandidates = append(pathDecodingCandidates, pathDecodingCandidate{%q, %s})\n", fn.name, fn.name)
+		}
+	}
+	output.WriteString("}\n")
+
+	if err := os.WriteFile(os.Args[2], output.Bytes(), 0o644); err != nil {
+		panic(err)
+	}
+}
+
+func findCandidates(directory string) ([]function, error) {
+	entries, err := os.ReadDir(directory)
+	if err != nil {
+		return nil, err
+	}
+
+	var candidates []function
+	files := token.NewFileSet()
+	for _, entry := range entries {
+		if entry.IsDir() || !strings.HasSuffix(entry.Name(), ".go") || strings.HasSuffix(entry.Name(), "_test.go") || entry.Name() == "path_contract_generator.go" {
+			continue
+		}
+		parsed, err := parser.ParseFile(files, filepath.Join(directory, entry.Name()), nil, 0)
+		if err != nil {
+			return nil, err
+		}
+		for _, declaration := range parsed.Decls {
+			fn, ok := declaration.(*ast.FuncDecl)
+			if !ok || fn.Recv != nil || !ast.IsExported(fn.Name.Name) || fn.Type.TypeParams != nil {
+				continue
+			}
+			if !isSingleString(fn.Type.Params) {
+				continue
+			}
+			if isSingleString(fn.Type.Results) {
+				candidates = append(candidates, function{name: fn.Name.Name, resultKind: 1})
+			} else if isStringAndError(fn.Type.Results) {
+				candidates = append(candidates, function{name: fn.Name.Name, resultKind: 2})
+			}
+		}
+	}
+	sort.Slice(candidates, func(i, j int) bool { return candidates[i].name < candidates[j].name })
+	return candidates, nil
+}
+
+func isSingleString(fields *ast.FieldList) bool {
+	return fields != nil && fieldCount(fields) == 1 && isIdentifier(fields.List[0].Type, "string")
+}
+
+func isStringAndError(fields *ast.FieldList) bool {
+	return fields != nil && fieldCount(fields) == 2 && len(fields.List) == 2 && isIdentifier(fields.List[0].Type, "string") && isIdentifier(fields.List[1].Type, "error")
+}
+
+func fieldCount(fields *ast.FieldList) int {
+	count := 0
+	for _, field := range fields.List {
+		if len(field.Names) == 0 {
+			count++
+		} else {
+			count += len(field.Names)
+		}
+	}
+	return count
+}
+
+func isIdentifier(expression ast.Expr, name string) bool {
+	identifier, ok := expression.(*ast.Ident)
+	return ok && identifier.Name == name
+}
diff --git a/url/path_contract_test.go b/url/path_contract_test.go
new file mode 100644
index 0000000..179295b
--- /dev/null
+++ b/url/path_contract_test.go
@@ -0,0 +1,138 @@
+package urlutil
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+)
+
+type pathEncodingCandidate struct {
+	name string
+	fn   func(string) string
+}
+
+type pathDecodingCandidate struct {
+	name string
+	fn   func(string) (string, error)
+}
+
+var pathEncodingCandidates []pathEncodingCandidate
+var pathDecodingCandidates []pathDecodingCandidate
+
+func normalizePercentEscapes(value string) string {
+	var result strings.Builder
+	for i := 0; i < len(value); i++ {
+		if value[i] == '%' && i+2 < len(value) && isHex(value[i+1]) && isHex(value[i+2]) {
+			result.WriteByte('%')
+			result.WriteByte(toUpperHex(value[i+1]))
+			result.WriteByte(toUpperHex(value[i+2]))
+			i += 2
+			continue
+		}
+		result.WriteByte(value[i])
+	}
+	return result.String()
+}
+
+func isHex(value byte) bool {
+	return value >= '0' && value <= '9' || value >= 'a' && value <= 'f' || value >= 'A' && value <= 'F'
+}
+
+func toUpperHex(value byte) byte {
+	if value >= 'a' && value <= 'f' {
+		return value - ('a' - 'A')
+	}
+	return value
+}
+
+func TestPathEncodingContract(t *testing.T) {
+	tests := []struct {
+		input string
+		want  string
+	}{
+		{"hello world", "hello%20world"},
+		{"literal+plus", "literal+plus"},
+		{"/key=value&other", "/key=value&other"},
+		{"path?query#fragment@host", "path%3Fquery%23fragment%40host"},
+		{"line\n\t", "line%0A%09"},
+		{"café", "caf%C3%A9"},
+		{"already%20encoded", "already%20encoded"},
+	}
+
+	var failures []string
+	for _, candidate := range pathEncodingCandidates {
+		matched := true
+		for _, test := range tests {
+			got := normalizePercentEscapes(candidate.fn(test.input))
+			if got != test.want {
+				matched = false
+				break
+			}
+		}
+		if matched {
+			return
+		}
+		failures = append(failures, candidate.name)
+	}
+	t.Fatalf("no exported string encoder satisfies path encoding behavior; checked %v", failures)
+}
+
+func TestPathDecodingContract(t *testing.T) {
+	tests := []struct {
+		input string
+		want  string
+	}{
+		{"hello%20world", "hello world"},
+		{"literal+plus", "literal+plus"},
+		{"/key=value&other", "/key=value&other"},
+		{"path%3Fquery%23fragment%40host", "path?query#fragment@host"},
+		{"line%0A%09", "line\n\t"},
+		{"caf%C3%A9", "café"},
+		{"bad%GGescape", "bad%GGescape"},
+		{"incomplete%2", "incomplete%2"},
+	}
+
+	var failures []string
+	for _, candidate := range pathDecodingCandidates {
+		matched := true
+		for _, test := range tests {
+			got, err := candidate.fn(test.input)
+			if err != nil || got != test.want {
+				matched = false
+				break
+			}
+		}
+		if matched {
+			return
+		}
+		failures = append(failures, candidate.name)
+	}
+	t.Fatalf("no exported string decoder satisfies path decoding behavior; checked %v", failures)
+}
+
+func TestPathEncodingRoundTrip(t *testing.T) {
+	values := []string{
+		"hello world",
+		"path?query#fragment@host",
+		"/key=value&literal+plus",
+		"line\nwith\tcontrol",
+		"café",
+	}
+
+	for _, encoder := range pathEncodingCandidates {
+		for _, decoder := range pathDecodingCandidates {
+			matched := true
+			for _, value := range values {
+				decoded, err := decoder.fn(encoder.fn(value))
+				if err != nil || decoded != value {
+					matched = false
+					break
+				}
+			}
+			if matched {
+				return
+			}
+		}
+	}
+	t.Fatal(fmt.Sprintf("no exported encoder/decoder pair satisfies path round-trip behavior (%d encoders, %d decoders)", len(pathEncodingCandidates), len(pathDecodingCandidates)))
+}
