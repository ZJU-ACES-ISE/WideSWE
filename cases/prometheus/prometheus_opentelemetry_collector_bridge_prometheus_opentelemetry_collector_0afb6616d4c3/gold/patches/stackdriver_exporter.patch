-func NormalizeMetricName(metricName string) string {
-	var normalizedMetricName []string
-
-	words := camelcase.Split(metricName)
-	for _, word := range words {
-		safeWord := strings.Trim(safeNameRE.ReplaceAllLiteralString(word, "_"), "_")
