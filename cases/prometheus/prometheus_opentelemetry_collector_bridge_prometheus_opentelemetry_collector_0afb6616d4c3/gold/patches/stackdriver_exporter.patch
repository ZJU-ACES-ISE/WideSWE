-func SplitExtraFilter(extraFilter string, separator string) (string, string) {
-	mPrefix := strings.SplitN(extraFilter, separator, 2)
-	if len(mPrefix) != 2 {
-		return "", ""
-	}
-	return mPrefix[0], mPrefix[1]
-}
