+func TestEcoSyncConfigPackageIsPureValueType(t *testing.T) {
+	fset := token.NewFileSet()
+	packages, err := parser.ParseDir(fset, "../config", nil, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	foundConfig := false
+	for _, pkg := range packages {
+		for filename, file := range pkg.Files {
+			if strings.HasSuffix(filename, "_test.go") {
+				continue
+			}
+			for _, spec := range file.Imports {
+				importPath, err := strconv.Unquote(spec.Path.Value)
+				if err != nil {
+					continue
+				}
+				if strings.Contains(importPath, "/collectors") || strings.HasPrefix(importPath, "google.golang.org/") || strings.Contains(importPath, "oauth") {
+					t.Errorf("config package imports runtime dependency %q", importPath)
+				}
+			}
+			for _, decl := range file.Decls {
+				gen, ok := decl.(*ast.GenDecl)
+				if !ok || gen.Tok != token.TYPE {
+					continue
+				}
+				for _, spec := range gen.Specs {
+					typeSpec, ok := spec.(*ast.TypeSpec)
+					if !ok || typeSpec.Name.Name != "Config" {
+						continue
+					}
+					foundConfig = true
+					structure, ok := typeSpec.Type.(*ast.StructType)
+					if !ok {
+						t.Error("config.Config is not a value struct")
+						continue
+					}
+					for _, field := range structure.Fields.List {
+						if field.Tag != nil && strings.Contains(field.Tag.Value, "mapstructure") {
+							t.Error("config.Config contains receiver-specific mapstructure tags")
+						}
+					}
+				}
+			}
+		}
+	}
+	if !foundConfig {
+		t.Error("config package does not define Config")
+	}
+}
