+const publicRuntimeConsumer = `package contract
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"log/slog"
+	"os"
+	"path/filepath"
+	"reflect"
+	"testing"
+	"time"
+
+	"github.com/prometheus-community/stackdriver_exporter/collectors"
+	"github.com/prometheus-community/stackdriver_exporter/config"
+)
+
+var errorType = reflect.TypeOf((*error)(nil)).Elem()
+
+func installCredentials(t *testing.T) {
+	t.Helper()
+	path := filepath.Join(t.TempDir(), "credentials.json")
+	data := []byte("{\"type\":\"authorized_user\",\"client_id\":\"test\",\"client_secret\":\"test\",\"refresh_token\":\"test\"}")
+	if err := os.WriteFile(path, data, 0600); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("GOOGLE_APPLICATION_CREDENTIALS", path)
+}
+
+func invokeNewRuntime(t *testing.T, cfg any) (reflect.Value, error) {
+	t.Helper()
+	fn := reflect.ValueOf(collectors.NewRuntime)
+	fnType := fn.Type()
+	ctx := reflect.ValueOf(context.Background())
+	logger := reflect.ValueOf(slog.New(slog.NewTextHandler(io.Discard, nil)))
+	configValue := reflect.ValueOf(cfg)
+	args := make([]reflect.Value, fnType.NumIn())
+	for i := 0; i < fnType.NumIn(); i++ {
+		paramType := fnType.In(i)
+		switch {
+		case ctx.Type().AssignableTo(paramType):
+			args[i] = ctx
+		case logger.Type().AssignableTo(paramType):
+			args[i] = logger
+		case adaptableConfig(configValue, paramType).IsValid():
+			args[i] = adaptableConfig(configValue, paramType)
+		case paramType.Kind() == reflect.Func:
+			args[i] = reflect.MakeFunc(paramType, func([]reflect.Value) []reflect.Value {
+				out := make([]reflect.Value, paramType.NumOut())
+				for i := range out {
+					out[i] = reflect.Zero(paramType.Out(i))
+				}
+				return out
+			})
+		default:
+			t.Fatalf("NewRuntime has unsupported public parameter %v", paramType)
+		}
+	}
+	outputs, panicErr := safeCall(fn, args)
+	if panicErr != nil {
+		return reflect.Value{}, panicErr
+	}
+	var runtime reflect.Value
+	for _, output := range outputs {
+		if output.Type().Implements(errorType) {
+			if !output.IsNil() {
+				return reflect.Value{}, output.Interface().(error)
+			}
+			continue
+		}
+		if !isNil(output) && output.MethodByName("Collectors").IsValid() {
+			runtime = output
+		}
+	}
+	if !runtime.IsValid() {
+		return reflect.Value{}, fmt.Errorf("NewRuntime did not return a Runtime with Collectors")
+	}
+	return runtime, nil
+}
+
+func adaptableConfig(value reflect.Value, target reflect.Type) reflect.Value {
+	if value.IsValid() && value.Type().AssignableTo(target) {
+		return value
+	}
+	if value.IsValid() && value.Kind() == reflect.Pointer && value.Elem().Type().AssignableTo(target) {
+		return value.Elem()
+	}
+	if value.IsValid() && value.Kind() != reflect.Pointer {
+		pointer := reflect.New(value.Type())
+		pointer.Elem().Set(value)
+		if pointer.Type().AssignableTo(target) {
+			return pointer
+		}
+	}
+	return reflect.Value{}
+}
+
+func safeCall(fn reflect.Value, args []reflect.Value) (outputs []reflect.Value, err error) {
+	defer func() {
+		if recovered := recover(); recovered != nil {
+			err = fmt.Errorf("call panicked: %v", recovered)
+		}
+	}()
+	return fn.Call(args), nil
+}
+
+func isNil(value reflect.Value) bool {
+	switch value.Kind() {
+	case reflect.Chan, reflect.Func, reflect.Interface, reflect.Map, reflect.Pointer, reflect.Slice:
+		return value.IsNil()
+	default:
+		return false
+	}
+}
+
+func runtimeMethod(runtime reflect.Value, name string, args ...reflect.Value) (reflect.Value, error) {
+	method := runtime.MethodByName(name)
+	if !method.IsValid() {
+		return reflect.Value{}, fmt.Errorf("Runtime has no %s method", name)
+	}
+	outputs, err := safeCall(method, args)
+	if err != nil {
+		return reflect.Value{}, err
+	}
+	for _, output := range outputs {
+		if output.Type().Implements(errorType) && !output.IsNil() {
+			return reflect.Value{}, output.Interface().(error)
+		}
+	}
+	for _, output := range outputs {
+		if output.Kind() == reflect.Slice {
+			return output, nil
+		}
+	}
+	return reflect.Value{}, nil
+}
+
+func withCache(runtime reflect.Value) (reflect.Value, error) {
+	method := runtime.MethodByName("WithCache")
+	if !method.IsValid() {
+		return reflect.Value{}, fmt.Errorf("Runtime has no WithCache method")
+	}
+	outputs, err := safeCall(method, nil)
+	if err != nil {
+		return reflect.Value{}, err
+	}
+	for _, output := range outputs {
+		if !isNil(output) && output.MethodByName("Collectors").IsValid() {
+			return output, nil
+		}
+	}
+	return runtime, nil
+}
+
+func collectorPointer(slice reflect.Value, index int) uintptr {
+	value := slice.Index(index)
+	for value.Kind() == reflect.Interface {
+		value = value.Elem()
+	}
+	if value.Kind() != reflect.Pointer {
+		return 0
+	}
+	return value.Pointer()
+}
+
+func TestConfigValidationContract(t *testing.T) {
+	bad := config.NewConfigWithDefaults()
+	if err := bad.Validate(); err == nil {
+		t.Fatal("config without metric prefixes passed validation")
+	}
+	if bad.Validated() {
+		t.Fatal("failed validation marked config validated")
+	}
+
+	good := config.NewConfigWithDefaults()
+	good.ProjectIDs = []string{"project-a", "project-b"}
+	good.MetricsPrefixes = []string{"compute.googleapis.com/", "pubsub.googleapis.com/"}
+	if err := good.Validate(); err != nil {
+		t.Fatalf("Validate() failed: %v", err)
+	}
+	if !good.Validated() {
+		t.Fatal("successful Validate() did not mark config validated")
+	}
+}
+
+func TestNewRuntimeRejectsUnvalidatedConfig(t *testing.T) {
+	cfg := config.NewConfigWithDefaults()
+	cfg.ProjectIDs = []string{"project-a"}
+	cfg.MetricsPrefixes = []string{"compute.googleapis.com/"}
+	if _, err := invokeNewRuntime(t, cfg); err == nil {
+		t.Fatal("NewRuntime accepted an unvalidated config")
+	}
+}
+
+func TestRuntimeCollectorsAndCache(t *testing.T) {
+	installCredentials(t)
+	cfg := config.NewConfigWithDefaults()
+	cfg.ProjectIDs = []string{"project-a", "project-b"}
+	cfg.MetricsPrefixes = []string{"compute.googleapis.com/", "pubsub.googleapis.com/"}
+	if err := cfg.Validate(); err != nil {
+		t.Fatal(err)
+	}
+	runtime, err := invokeNewRuntime(t, cfg)
+	if err != nil {
+		t.Fatalf("NewRuntime() failed: %v", err)
+	}
+	first, err := runtimeMethod(runtime, "Collectors")
+	if err != nil {
+		t.Fatal(err)
+	}
+	second, err := runtimeMethod(runtime, "Collectors")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if first.Len() != 2 || second.Len() != 2 {
+		t.Fatalf("Collectors returned %d and %d collectors, want one per project", first.Len(), second.Len())
+	}
+	if collectorPointer(first, 0) == collectorPointer(second, 0) {
+		t.Fatal("uncached Runtime reused a collector")
+	}
+
+	cached, err := withCache(runtime)
+	if err != nil {
+		t.Fatal(err)
+	}
+	all, err := runtimeMethod(cached, "Collectors")
+	if err != nil {
+		t.Fatal(err)
+	}
+	nilFilter, err := runtimeMethod(cached, "CollectorsForPrefixes", reflect.Zero(reflect.TypeOf([]string{})))
+	if err != nil {
+		t.Fatal(err)
+	}
+	emptyFilter, err := runtimeMethod(cached, "CollectorsForPrefixes", reflect.ValueOf([]string{}))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if all.Len() != 2 || collectorPointer(all, 0) != collectorPointer(nilFilter, 0) || collectorPointer(all, 0) != collectorPointer(emptyFilter, 0) {
+		t.Fatal("nil and empty prefix filters did not reuse all configured prefixes")
+	}
+
+	filter := reflect.ValueOf([]string{"compute.googleapis.com/instance"})
+	filtered, err := runtimeMethod(cached, "CollectorsForPrefixes", filter)
+	if err != nil {
+		t.Fatal(err)
+	}
+	filteredAgain, err := runtimeMethod(cached, "CollectorsForPrefixes", filter)
+	if err != nil {
+		t.Fatal(err)
+	}
+	otherFilter, err := runtimeMethod(cached, "CollectorsForPrefixes", reflect.ValueOf([]string{"pubsub.googleapis.com/subscription"}))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if collectorPointer(filtered, 0) != collectorPointer(filteredAgain, 0) {
+		t.Fatal("cache did not reuse a collector for the same project and prefix filter")
+	}
+	if collectorPointer(filtered, 0) == collectorPointer(otherFilter, 0) {
+		t.Fatal("cache reused a collector for a different prefix filter")
+	}
+}
+
+func TestRuntimeCacheExpiry(t *testing.T) {
+	installCredentials(t)
+	cfg := config.NewConfigWithDefaults()
+	cfg.ProjectIDs = []string{"project-a"}
+	cfg.MetricsPrefixes = []string{"compute.googleapis.com/"}
+	cfg.AggregateDeltas = true
+	cfg.AggregateDeltasTTL = 20 * time.Millisecond
+	if err := cfg.Validate(); err != nil {
+		t.Fatal(err)
+	}
+	runtime, err := invokeNewRuntime(t, cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	runtime, err = withCache(runtime)
+	if err != nil {
+		t.Fatal(err)
+	}
+	first, err := runtimeMethod(runtime, "Collectors")
+	if err != nil {
+		t.Fatal(err)
+	}
+	time.Sleep(50 * time.Millisecond)
+	second, err := runtimeMethod(runtime, "Collectors")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if collectorPointer(first, 0) == collectorPointer(second, 0) {
+		t.Fatal("cached collector remained after the configured cache lifetime")
+	}
+}
+`
