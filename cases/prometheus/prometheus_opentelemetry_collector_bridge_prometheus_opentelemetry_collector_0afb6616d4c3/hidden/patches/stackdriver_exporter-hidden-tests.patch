+func TestEcoSyncFilterErrorsUseHTTP500(t *testing.T) {
+	fset := token.NewFileSet()
+	packages, err := parser.ParseDir(fset, "..", nil, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	serveReceiver := ""
+	methods := []*ast.FuncDecl{}
+	hasInternalServerError := false
+	for _, pkg := range packages {
+		for filename, file := range pkg.Files {
+			if strings.HasSuffix(filename, "_test.go") {
+				continue
+			}
+			for _, decl := range file.Decls {
+				fn, ok := decl.(*ast.FuncDecl)
+				if !ok {
+					continue
+				}
+				if fn.Recv != nil {
+					methods = append(methods, fn)
+				}
+				if fn.Name.Name == "ServeHTTP" {
+					serveReceiver = receiverTypeName(fn)
+				}
+				ast.Inspect(fn.Body, func(node ast.Node) bool {
+					switch n := node.(type) {
+					case *ast.SelectorExpr:
+						if n.Sel.Name == "StatusInternalServerError" {
+							hasInternalServerError = true
+						}
+					case *ast.BasicLit:
+						if n.Kind == token.INT && n.Value == "500" {
+							hasInternalServerError = true
+						}
+					}
+					return true
+				})
+			}
+		}
+	}
+	if serveReceiver == "" {
+		t.Fatal("HTTP handler does not implement ServeHTTP")
+	}
+	if !hasInternalServerError {
+		t.Error("filter-path errors are not mapped to HTTP 500")
+	}
+	for _, method := range methods {
+		if receiverTypeName(method) != serveReceiver {
+			continue
+		}
+		ast.Inspect(method.Body, func(node ast.Node) bool {
+			call, ok := node.(*ast.CallExpr)
+			if !ok {
+				return true
+			}
+			selector, ok := call.Fun.(*ast.SelectorExpr)
+			if !ok || selector.Sel.Name != "Exit" {
+				return true
+			}
+			if pkg, ok := selector.X.(*ast.Ident); ok && pkg.Name == "os" {
+				t.Errorf("HTTP handler method %s exits the process on a request error", method.Name.Name)
+			}
+			return true
+		})
+	}
+}
