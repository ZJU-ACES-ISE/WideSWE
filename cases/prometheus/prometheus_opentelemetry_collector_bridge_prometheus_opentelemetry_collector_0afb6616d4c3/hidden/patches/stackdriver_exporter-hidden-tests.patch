+func TestEcoSyncMetricFilterParsing(t *testing.T) {
+	got := collectors.ParseMetricExtraFilters([]string{
+		"Compute.Googleapis.Com/Instance:resource.labels.zone=us-central1-a",
+		"invalid-filter",
+	})
+	want := []collectors.MetricFilter{{
+		TargetedMetricPrefix: "compute.googleapis.com/instance",
+		FilterQuery:          "resource.labels.zone=us-central1-a",
+	}}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("ParseMetricExtraFilters() = %#v, want %#v", got, want)
+	}
+}
+
+func receiverTypeName(fn *ast.FuncDecl) string {
+	if fn.Recv == nil || len(fn.Recv.List) == 0 {
+		return ""
+	}
+	typeExpr := fn.Recv.List[0].Type
+	if pointer, ok := typeExpr.(*ast.StarExpr); ok {
+		typeExpr = pointer.X
+	}
+	if ident, ok := typeExpr.(*ast.Ident); ok {
+		return ident.Name
+	}
+	return ""
+}
