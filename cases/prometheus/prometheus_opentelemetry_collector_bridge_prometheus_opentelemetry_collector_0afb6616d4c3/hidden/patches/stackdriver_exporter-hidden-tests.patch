+func TestEcoSyncPublicConfigAndRuntime(t *testing.T) {
+	root, err := filepath.Abs("..")
+	if err != nil {
+		t.Fatal(err)
+	}
+	consumer := t.TempDir()
+	goMod := "module ecosync-public-contract\n\ngo 1.25.0\n\nrequire github.com/prometheus-community/stackdriver_exporter v0.0.0\n\nreplace github.com/prometheus-community/stackdriver_exporter => " + root + "\n"
+	if err := os.WriteFile(filepath.Join(consumer, "go.mod"), []byte(goMod), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(consumer, "runtime_test.go"), []byte(publicRuntimeConsumer), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	cmd := exec.Command("go", "test", "-count=1", ".")
+	cmd.Dir = consumer
+	cmd.Env = append(os.Environ(), "GOTOOLCHAIN=local")
+	output, err := cmd.CombinedOutput()
+	if err != nil {
+		t.Fatalf("public Config/Runtime contract failed: %v\n%s", err, output)
+	}
+}
