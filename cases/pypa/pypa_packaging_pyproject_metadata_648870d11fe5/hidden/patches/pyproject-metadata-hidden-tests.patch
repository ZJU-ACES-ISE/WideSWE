+def test_import_name_validation(
+    valid_project: dict[str, object],
+    invalid_project: dict[str, object],
+    all_errors: bool,
+) -> None:
+    base_project = {"name": "test", "version": "0.1.0"}
+    pyproject_metadata.StandardMetadata.from_pyproject(
+        {"project": {**base_project, **valid_project}},
+        allow_extra_keys=False,
+        all_errors=all_errors,
+    )
+
+    error_type = (
+        pyproject_metadata.errors.ExceptionGroup
+        if all_errors
+        else pyproject_metadata.ConfigurationError
+    )
+    with pytest.raises(error_type):
+        pyproject_metadata.StandardMetadata.from_pyproject(
+            {"project": {**base_project, **invalid_project}},
+            allow_extra_keys=False,
+            all_errors=all_errors,
+        )
+
