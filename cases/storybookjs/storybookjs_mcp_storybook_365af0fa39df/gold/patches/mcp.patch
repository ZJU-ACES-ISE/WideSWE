diff --git a/eval/tasks/905-existing-component-write-story-reshaped/pre-execute-agent/src/components/AlertBanner.tsx b/eval/tasks/905-existing-component-write-story-reshaped/pre-execute-agent/src/components/AlertBanner.tsx
new file mode 100644
