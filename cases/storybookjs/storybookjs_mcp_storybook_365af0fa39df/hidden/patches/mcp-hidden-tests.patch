+			},
+		});
+
+		expect(summary.allExpectationsPassed).toBe(true);
+		const runTool = summary.tools.find((t) => t.name.includes('run-story-tests'));
+		expect(runTool?.callCount).toBe(2);
+		expect(runTool?.validation?.minCallsMet).toBe(true);
+	});
+
