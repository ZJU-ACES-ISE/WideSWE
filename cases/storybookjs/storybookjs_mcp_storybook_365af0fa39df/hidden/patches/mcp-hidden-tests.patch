+
+			- button--primary"
+		`);
+		expect(mockChannel.emit).toHaveBeenCalledWith(
+			'storybook/test/trigger-test-run-request',
+			expect.objectContaining({
+				actor: 'addon-mcp',
+				storyIds: ['button--primary'],
+				config: { a11y: true },
+			}),
+		);
+	});
+
+	it('should run all tests when stories input is omitted', async () => {
