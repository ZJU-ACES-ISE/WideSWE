+	for (const c of string) {
+		if (c === '\\') {
+			out += '\\\\';
+		} else if (c === char) {
+			out += '\\' + c;
+		} else if (c === '\n') {
+			out += '\\n';
+		} else if (c === '\r') {
+			out += '\\r';
+		} else {
+			out += c;
+		}
+	}
