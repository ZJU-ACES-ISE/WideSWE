+			if (UNEXPECTED(!prop_key)) {
+				zend_value_error("deepclone_hydrate(): Argument #3 ($mangled_vars) must have only string keys");
+				if (scoped_owned) zval_ptr_dtor(&local_scoped);
+				if (created) zval_ptr_dtor(&obj_zval);
+				return;
+			}
