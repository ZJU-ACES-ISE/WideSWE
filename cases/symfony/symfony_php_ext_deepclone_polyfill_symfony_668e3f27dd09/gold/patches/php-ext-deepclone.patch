+				ZVAL_LONG(&zok, ok ? 1 : 0);
+				zend_hash_add_new(&hydrate_cache, ce->name, &zok);
+				if (!ok) {
+					zend_throw_exception_ex(dc_ce_not_instantiable_exception, 0,
+						"Class \"%s\" is not instantiable.", ZSTR_VAL(ce->name));
+					return;
+				}
